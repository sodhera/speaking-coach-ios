    "One point → why it matters here → where you are taking us.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una idea → por qué importa aquí → adónde vamos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une idée → pourquoi elle compte ici → où tu nous emmènes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt → warum er hier zählt → wohin du uns führst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto → perché conta qui → dove ci stai portando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ideia → por que ela importa aqui → para onde você vai nos levar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén punt → waarom het hier telt → waar je ons mee naartoe neemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna myśl → dlaczego jest tu ważna → dokąd nas prowadzisz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En poäng → varför den spelar roll här → vart du tar oss."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek fikir → burada neden önemli → bizi nereye götürdüğün."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна мысль → почему она важна здесь → куда вы нас ведёте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна думка → чому вона важлива тут → куди ви нас ведете."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बात → यहाँ यह क्यों मायने रखती है → आप हमें कहाँ ले जा रहे हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فكرة واحدة ← لماذا تهم هنا ← إلى أين تأخذنا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要点一つ → ここで大切な理由 → どこへ導くか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요점 하나 → 여기서 중요한 이유 → 어디로 이끌지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个观点 → 为什么在这里重要 → 你要带我们去哪里。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu poin → mengapa penting di sini → ke mana kamu membawa kami."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang punto → bakit ito mahalaga rito → saan mo kami dadalhin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ý → vì sao nó quan trọng ở đây → bạn đưa chúng tôi đi đâu."
          }
        }
      },
      "comment": "Practice scene presentation_opening: scaffold"
    },
    "Open a presentation or toast": {
