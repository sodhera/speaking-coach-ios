    "Ask a genuine follow-up and respect their time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta de seguimiento sincera y respeta su tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une vraie question de relance et respecte son temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine echte Nachfrage und respektiere die Zeit der anderen Person."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda di approfondimento sincera e rispetta il suo tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta de continuidade sincera e respeite o tempo da pessoa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een oprechte vervolgvraag en respecteer hun tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj szczere pytanie uzupełniające i szanuj czas tej osoby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ en genuin följdfråga och respektera den andras tid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçten bir takip sorusu sor ve zamanına saygı göster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте искренний уточняющий вопрос и уважайте время собеседника."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте щире уточнювальне питання й шануйте час співрозмовника."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सच्चा आगे का सवाल पूछें और उनके समय का सम्मान करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح سؤال متابعة صادقًا واحترم وقته."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心からの追加の質問をし、相手の時間を尊重する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진심 어린 추가 질문을 하고 상대의 시간을 존중한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真诚地追问，并尊重对方的时间。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajukan pertanyaan lanjutan yang tulus dan hargai waktunya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong ng taos-pusong follow-up at igalang ang oras nila."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi tiếp một cách chân thành và tôn trọng thời gian của họ."
