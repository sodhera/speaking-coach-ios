    "I noticed a problem with the handover. Can you explain what happened?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He visto un problema con el traspaso. ¿Puedes explicar qué pasó?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai remarqué un problème avec la passation. Tu peux m'expliquer ce qui s'est passé ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist ein Problem bei der Übergabe aufgefallen. Kannst du erklären, was passiert ist?"
          }
