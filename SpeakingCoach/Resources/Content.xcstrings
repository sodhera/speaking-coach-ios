    "Identify what is unclear and confirm an actionable expectation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica lo que no está claro y confirma una expectativa concreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifie ce qui n'est pas clair et confirme une attente concrète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde heraus, was unklar ist, und bestätige eine umsetzbare Erwartung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua cosa non è chiaro e conferma un'aspettativa concreta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifique o que não está claro e confirme uma expectativa concreta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Benoem wat onduidelijk is en bevestig een concrete verwachting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określ, co jest niejasne, i potwierdź konkretne oczekiwanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta reda på vad som är oklart och bekräfta en konkret förväntan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin belirsiz olduğunu belirle ve uygulanabilir bir beklentiyi teyit et."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите, что неясно, и подтвердите конкретное ожидание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначте, що незрозуміло, і підтвердьте конкретне очікування."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचानें कि क्या स्पष्ट नहीं है और एक ठोस अपेक्षा की पुष्टि करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد ما هو غير واضح وأكّد توقعًا قابلًا للتنفيذ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が不明確かを見極め、具体的な期待を確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 불명확한지 짚고, 실행 가능한 기대치를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找出不清楚的地方，并确认一个可执行的期望。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali apa yang tidak jelas dan pastikan harapan yang bisa dijalankan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukuyin kung ano ang hindi malinaw at kumpirmahin ang inaasahang magagawa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác định điều chưa rõ và xác nhận một kỳ vọng có thể thực hiện."
          }
        }
      },
      "comment": "Practice scene ask_for_clarity: objective"
    },
    "Imagine your audience is ready. How would you begin?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagina que tu público está listo. ¿Cómo empezarías?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que ton public est prêt. Comment commencerais-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, dein Publikum ist bereit. Wie würdest du beginnen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina che il tuo pubblico sia pronto. Come inizieresti?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que seu público está pronto. Como você começaria?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor dat je publiek klaarzit. Hoe zou je beginnen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyobraź sobie, że publiczność jest gotowa. Jak byś zaczął?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreställ dig att publiken är redo. Hur skulle du börja?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinleyicilerinin hazır olduğunu hayal et. Nasıl başlardın?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, что аудитория готова. С чего бы вы начали?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уявіть, що аудиторія готова. З чого б ви почали?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोचिए कि आपके श्रोता तैयार हैं। आप कैसे शुरू करेंगे?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخيّل أن جمهورك مستعد. كيف ستبدأ؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き手の準備ができたと想像してください。どう始めますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청중이 준비되었다고 상상해 보세요. 어떻게 시작하시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象听众已经准备好了。你会怎么开始？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
