    "Use the same three-part introduction the next time you meet someone new.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la misma presentación en tres partes la próxima vez que conozcas a alguien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la même présentation en trois parties la prochaine fois que tu rencontres quelqu'un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze dieselbe dreiteilige Vorstellung, wenn du das nächste Mal jemanden kennenlernst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la stessa presentazione in tre parti la prossima volta che conosci qualcuno."
