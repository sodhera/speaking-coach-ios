    "Situation → your action → result. A small real example is enough.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Situación → tu acción → resultado. Basta con un ejemplo real pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Situation → ton action → résultat. Un petit exemple réel suffit."
          }
