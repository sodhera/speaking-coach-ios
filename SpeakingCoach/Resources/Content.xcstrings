    "You are given a project you have never done before. How would you begin?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dan un proyecto que nunca has hecho. ¿Cómo empezarías?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te confie un projet que tu n'as jamais fait. Comment commencerais-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst ein Projekt, das du noch nie gemacht hast. Wie würdest du anfangen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
