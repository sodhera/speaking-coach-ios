    "Share one thing about yourself, then ask about something they mentioned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta algo sobre ti y luego pregunta por algo que haya mencionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage une chose sur toi, puis pose une question sur ce qu'il a mentionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl etwas über dich und frag dann nach etwas, das dein Gegenüber erwähnt hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racconta una cosa di te, poi chiedi di qualcosa che ha menzionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte uma coisa sobre você e depois pergunte sobre algo que a pessoa mencionou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel één ding over jezelf en vraag dan naar iets wat de ander noemde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz jedną rzecz o sobie, a potem zapytaj o coś, o czym wspomniała ta osoba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta en sak om dig själv och fråga sedan om något den andra nämnde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendinle ilgili bir şey paylaş, sonra karşındakinin bahsettiği bir şeyi sor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите что-нибудь о себе, а затем спросите о том, что упомянул собеседник."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкажіть щось про себе, а потім запитайте про те, що згадав співрозмовник."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बारे में एक बात बताएँ, फिर उनकी कही किसी बात के बारे में पूछें।"
