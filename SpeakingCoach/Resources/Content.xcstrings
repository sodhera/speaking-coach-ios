    "What happened → my part → impact → repair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué pasó → mi parte → impacto → solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui s'est passé → ma part → impact → réparation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was passiert ist → mein Anteil → Folgen → Lösung."
          }
        },
        "it": {
