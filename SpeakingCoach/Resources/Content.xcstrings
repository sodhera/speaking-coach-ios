    "You have my attention. What is your idea, and why should it matter?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes mi atención. ¿Cuál es tu idea y por qué debería importar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je t'écoute. Quelle est ton idée, et pourquoi devrait-elle compter ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast meine Aufmerksamkeit. Was ist deine Idee, und warum sollte sie zählen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai la mia attenzione. Qual è la tua idea, e perché dovrebbe contare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem minha atenção. Qual é a sua ideia, e por que ela importa?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt mijn aandacht. Wat is je idee, en waarom zou het ertoe doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz moją uwagę. Jaki jest twój pomysł i dlaczego ma znaczenie?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har min uppmärksamhet. Vad är din idé, och varför spelar den roll?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkatimi çektin. Fikrin ne ve neden önemli olsun?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я слушаю. В чём ваша идея и почему она важна?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я слухаю. У чому ваша ідея і чому вона важлива?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने मेरा ध्यान खींचा है। आपका विचार क्या है, और यह क्यों मायने रखता है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك انتباهي. ما فكرتك، ولماذا ينبغي أن تهم؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞かせてください。どんなアイデアで、なぜ重要なんですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣고 있어요. 어떤 아이디어이고, 왜 중요한가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说吧。你的想法是什么，为什么重要？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mendengarkan. Apa idemu, dan mengapa ini penting?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikinig ako. Ano ang ideya mo, at bakit ito mahalaga?"
