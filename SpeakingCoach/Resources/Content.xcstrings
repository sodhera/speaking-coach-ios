    "Use a brief thinking pause before your next unfamiliar question.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate una breve pausa para pensar antes de tu próxima pregunta desconocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends une courte pause de réflexion avant ta prochaine question inconnue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir vor deiner nächsten unbekannten Frage eine kurze Denkpause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenditi una breve pausa per pensare prima della prossima domanda nuova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
