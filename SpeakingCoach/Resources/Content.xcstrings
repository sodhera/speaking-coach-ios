        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tego samego trzyczęściowego przedstawienia, gdy następnym razem kogoś poznasz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd samma presentation i tre delar nästa gång du träffar någon ny."
