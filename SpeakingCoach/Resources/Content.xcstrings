            "value": "تحمّل مسؤولية دورك دون إلقاء اللوم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "責任転嫁せずに自分の非を認める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남 탓 없이 내 몫을 인정한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "承担你的责任，不推卸。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akui bagianmu tanpa melempar kesalahan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panagutan ang bahagi mo nang hindi nagtuturo ng iba."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận phần của mình mà không đổ lỗi."
          }
        }
      },
      "comment": "Practice scene explain_a_mistake: what the feedback listens for"
    },
    "Pause. Name what you know, then one sensible next step.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pausa. Di lo que sabes y luego un siguiente paso sensato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque une pause. Dis ce que tu sais, puis une étape suivante raisonnable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine Pause. Sag, was du weißt, dann einen sinnvollen nächsten Schritt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una pausa. Di' cosa sai, poi un passo successivo sensato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pausa. Diga o que você sabe e depois um próximo passo sensato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer. Noem wat je weet, en dan een verstandige volgende stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj się. Powiedz, co wiesz, a potem jeden rozsądny krok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa. Säg vad du vet och sedan ett rimligt nästa steg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraksa. Bildiğini söyle, sonra mantıklı bir sonraki adımı."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте паузу. Скажите, что знаете, а затем один разумный следующий шаг."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть паузу. Скажіть, що знаєте, а потім один розумний наступний крок."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुकें। जो जानते हैं वह बताएँ, फिर एक समझदारी भरा अगला कदम।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف لحظة. قل ما تعرفه، ثم خطوة تالية معقولة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間を取りましょう。わかっていることを言い、次の妥当な一歩を示して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 멈추세요. 아는 것을 말하고, 합리적인 다음 단계 하나를 제시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停一下。说出你知道的，再说一个合理的下一步。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda. Sebutkan apa yang kamu tahu, lalu satu langkah berikutnya yang masuk akal."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
