    "Maintain the limit after pushback.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el límite tras la insistencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens la limite malgré l'insistance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Grenze auch bei Nachdruck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il limite anche se insistono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o limite depois da insistência."
          }
        },
