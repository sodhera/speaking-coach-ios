        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य बात, रुकावट और एक उपयोगी अगला कदम बताएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قدّم الخلاصة، والعائق، وخطوة تالية مفيدة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
