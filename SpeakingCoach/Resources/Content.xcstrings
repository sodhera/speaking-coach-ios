    "Present → evidence → why this role. Use your own facts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente → prueba → por qué este puesto. Usa tus propios datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présent → preuve → pourquoi ce poste. Utilise tes propres faits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute → Beleg → warum diese Stelle. Nutze deine eigenen Fakten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente → prova → perché questo ruolo. Usa fatti tuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presente → evidência → por que esta vaga. Use seus próprios fatos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu → bewijs → waarom deze functie. Gebruik je eigen feiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz → dowód → dlaczego to stanowisko. Używaj własnych faktów."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu → belägg → varför den här rollen. Använd dina egna fakta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi → kanıt → neden bu rol. Kendi gerçeklerini kullan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас → доказательство → почему эта роль. Используйте свои факты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз → доказ → чому ця роль. Використовуйте свої факти."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी → सबूत → यही भूमिका क्यों। अपने तथ्यों का उपयोग करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحاضر ← الدليل ← لماذا هذا الدور. استخدم حقائقك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 → 根拠 → この職種を選ぶ理由。自分の事実で話しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 → 근거 → 이 직무인 이유. 나의 사실로 말하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在 → 依据 → 为什么是这个职位。用你自己的真实情况。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang → bukti → mengapa posisi ini. Gunakan faktamu sendiri."
          }
        },
        "fil": {
