        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de kern, de blokkade en een nuttige volgende stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj najważniejsze, przeszkodę i przydatny następny krok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge rubriken, hindret och ett användbart nästa steg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özeti, engeli ve yararlı bir sonraki adımı söyle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите главное, препятствие и полезный следующий шаг."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвіть головне, перешкоду й корисний наступний крок."
