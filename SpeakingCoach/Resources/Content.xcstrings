    "Test your opening with a peer and ask what they understood.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba tu arranque con un compañero y pregúntale qué entendió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste ton ouverture avec un collègue et demande-lui ce qu'il a compris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste deinen Einstieg bei einer Kollegin und frag, was sie verstanden hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova la tua apertura con un collega e chiedigli cosa ha capito."
          }
