          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심, 걸림돌, 유용한 다음 단계를 말하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出重点、阻碍，以及一个有用的下一步。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampaikan inti, hambatan, dan langkah berikutnya yang berguna."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibigay ang buod, ang hadlang, at isang kapaki-pakinabang na susunod na hakbang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nêu điểm chính, vướng mắc và một bước tiếp theo hữu ích."
          }
        }
      },
      "comment": "Practice scene clear_work_update: objective"
    },
    "Give the opening a clear direction.": {
