    "Make a clear request, support it with evidence, and agree on a next step.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una petición clara, respáldala con pruebas y acordad un siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais une demande claire, appuie-la par des preuves et convenez d'une prochaine étape."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine klare Bitte, belege sie und einigt euch auf einen nächsten Schritt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una richiesta chiara, sostienila con i fatti e concordate un passo successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um pedido claro, sustente-o com evidências e combinem um próximo passo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe een duidelijk verzoek, onderbouw het en spreek een volgende stap af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sformułuj jasną prośbę, poprzyj ją dowodami i ustal następny krok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framför en tydlig begäran, backa upp den med belägg och kom överens om ett nästa steg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net bir talepte bulun, kanıtla destekle ve bir sonraki adımda anlaşın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформулируйте чёткую просьбу, подкрепите её фактами и договоритесь о следующем шаге."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сформулюйте чітке прохання, підкріпіть його фактами й домовтеся про наступний крок."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ़ माँग रखें, सबूत के साथ उसका समर्थन करें और अगले कदम पर सहमति बनाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قدّم طلبًا واضحًا، وادعمه بالأدلة، واتفقا على خطوة تالية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はっきりお願いし、根拠で支え、次の一歩で合意しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확하게 요청하고, 근거로 뒷받침하고, 다음 단계에 합의하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确提出请求，用证据支持，并就下一步达成一致。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajukan permintaan yang jelas, dukung dengan bukti, dan sepakati langkah berikutnya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa ng malinaw na hiling, suportahan ito ng patunay, at magkasundo sa susunod na hakbang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa ra đề nghị rõ ràng, hỗ trợ bằng bằng chứng và thống nhất bước tiếp theo."
          }
        }
      },
      "comment": "Practice scene salary_raise: objective"
    },
