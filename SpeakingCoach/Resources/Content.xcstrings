    },
    "Open with a clear point and a reason the audience should care.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con una idea clara y una razón por la que al público le importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par une idée claire et une raison pour laquelle le public devrait s'y intéresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einem klaren Punkt und einem Grund, warum er das Publikum angeht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti con un punto chiaro e un motivo per cui interessa al pubblico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com uma ideia clara e um motivo para o público se importar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open met een helder punt en een reden waarom het publiek het belangrijk vindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od jasnej myśli i powodu, dla którego publiczność powinna się nią przejąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inled med en tydlig poäng och ett skäl till varför publiken bör bry sig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net bir fikir ve dinleyicilerin neden önemsemesi gerektiğiyle aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с ясной мысли и причины, почему она важна аудитории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із ясної думки й причини, чому вона важлива для аудиторії."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साफ़ बात और एक कारण से शुरू करें कि श्रोताओं को इसकी परवाह क्यों करनी चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بفكرة واضحة وسبب يجعل الجمهور يهتم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確な要点と、聞き手にとって大切な理由から始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확한 요점과 청중이 관심을 가져야 할 이유로 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一个清晰的观点和听众应当关心的理由开场。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dengan poin yang jelas dan alasan audiens perlu peduli."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula sa malinaw na punto at dahilan kung bakit dapat itong mahalaga sa audience."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở đầu bằng một ý rõ ràng và lý do khán giả nên quan tâm."
          }
        }
      },
      "comment": "Practice scene presentation_opening: objective"
    },
    "Own a mistake, explain the impact, and propose a repair.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asume un error, explica el impacto y propón una solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assume une erreur, explique son impact et propose une réparation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm Verantwortung für einen Fehler, erkläre die Folgen und schlag eine Lösung vor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci un errore, spiega l'impatto e proponi una soluzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma um erro, explique o impacto e proponha uma correção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een fout op je, leg de impact uit en stel een oplossing voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj się do błędu, wyjaśnij skutki i zaproponuj naprawę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ansvar för ett misstag, förklara följderna och föreslå en lösning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hatayı üstlen, etkisini açıkla ve bir düzeltme öner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Признайте ошибку, объясните последствия и предложите исправление."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визнайте помилку, поясніть наслідки й запропонуйте виправлення."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलती स्वीकारें, उसका असर समझाएँ और सुधार सुझाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعترف بخطأ، واشرح أثره، واقترح إصلاحًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミスを認め、影響を説明し、対応策を提案しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실수를 인정하고, 영향을 설명하고, 해결책을 제안하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "承认错误，说明影响，并提出补救办法。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akui kesalahan, jelaskan dampaknya, dan usulkan perbaikan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Panagutan ang pagkakamali, ipaliwanag ang epekto, at magmungkahi ng paraan para ayusin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận sai sót, giải thích ảnh hưởng và đề xuất cách khắc phục."
          }
        }
      },
      "comment": "Practice scene explain_a_mistake: objective"
    },
    "Own your part without shifting blame.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asume tu parte sin echar la culpa a otros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assume ta part sans rejeter la faute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh zu deinem Anteil, ohne die Schuld abzuschieben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci la tua parte senza scaricare la colpa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma sua parte sem transferir a culpa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je deel op je zonder de schuld af te schuiven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weź odpowiedzialność za swoją część, nie zrzucając winy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ansvar för din del utan att skylla ifrån dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suçu başkasına atmadan payını üstlen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Признайте свою часть, не перекладывая вину."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визнайте свою частину, не перекладаючи провину."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
