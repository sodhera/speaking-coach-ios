        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dahaki sefere biriyle tanıştığında aynı üç bölümlü tanıtımı kullan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте то же представление из трёх частей, когда в следующий раз с кем-то познакомитесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте те саме представлення з трьох частин, коли наступного разу з кимось познайомитеся."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार किसी नए से मिलें तो यही तीन हिस्सों वाला परिचय इस्तेमाल करें।"
