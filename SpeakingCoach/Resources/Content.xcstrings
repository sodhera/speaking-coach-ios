    "Acknowledge a view, explain your concern, and offer an alternative.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconoce una opinión, explica tu preocupación y ofrece una alternativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnais un point de vue, explique ta préoccupation et propose une alternative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne eine Sicht an, erkläre deine Bedenken und biete eine Alternative an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconosci un punto di vista, spiega la tua preoccupazione e offri un'alternativa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconheça uma opinião, explique sua preocupação e ofereça uma alternativa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Erken een standpunt, leg je zorg uit en bied een alternatief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uznaj cudzy punkt widzenia, wyjaśnij swoją obawę i zaproponuj alternatywę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkänn en synpunkt, förklara din oro och föreslå ett alternativ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görüşü kabul et, endişeni açıkla ve bir alternatif sun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Признайте чужую точку зрения, объясните опасение и предложите альтернативу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визнайте чужу думку, поясніть занепокоєння й запропонуйте альтернативу."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक राय को स्वीकारें, अपनी चिंता समझाएँ और एक विकल्प दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعترف بوجهة نظر، واشرح قلقك، واقترح بديلًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の意見を認め、懸念を説明し、代案を出しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 의견을 인정하고, 우려를 설명하고, 대안을 제시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认可对方观点，说明你的顾虑，并提出替代方案。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akui sebuah pandangan, jelaskan kekhawatiranmu, dan tawarkan alternatif."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilalanin ang isang pananaw, ipaliwanag ang alalahanin mo, at mag-alok ng alternatibo."
