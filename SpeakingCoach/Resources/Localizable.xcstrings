          }
        }
      }
    },
    "Speaking Coach needs the microphone to hear your answer. Turn it on in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach necesita el micrófono para oír tu respuesta. Actívalo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach a besoin du micro pour entendre ta réponse. Active-le dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach braucht das Mikrofon, um deine Antwort zu hören. Schalte es in den Einstellungen ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach ha bisogno del microfono per sentire la tua risposta. Attivalo in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Speaking Coach precisa do microfone para ouvir sua resposta. Ative-o em Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach heeft de microfoon nodig om je antwoord te horen. Zet hem aan in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach potrzebuje mikrofonu, aby usłyszeć twoją odpowiedź. Włącz go w Ustawieniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach behöver mikrofonen för att höra ditt svar. Slå på den i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach'un yanıtını duyabilmesi için mikrofon gerekiyor. Ayarlar'dan aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach нужен микрофон, чтобы услышать ваш ответ. Включите его в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach потрібен мікрофон, щоб почути вашу відповідь. Увімкніть його в Параметрах."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका जवाब सुनने के लिए Speaking Coach को माइक्रोफ़ोन चाहिए। सेटिंग्स में इसे चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Speaking Coach إلى الميكروفون ليسمع إجابتك. شغّله في الإعدادات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を聞き取るため、Speaking Coachにはマイクが必要です。「設定」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach가 답변을 들으려면 마이크가 필요해요. 설정에서 켜 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach 需要麦克风才能听到你的回答。请在“设置”中打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach butuh mikrofon untuk mendengar jawabanmu. Nyalakan di Pengaturan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Speaking Coach ang mikropono para marinig ang sagot mo. I-on ito sa Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach cần micrô để nghe câu trả lời của bạn. Hãy bật trong Cài đặt."
          }
        }
      }
    },
