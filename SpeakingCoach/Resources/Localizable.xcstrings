    "Close. Try it again, keeping the words in order.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi. Inténtalo otra vez, manteniendo el orden de las palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque. Réessaie en gardant les mots dans l'ordre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast. Versuch es noch einmal und halte die Reihenfolge der Wörter ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi. Riprova mantenendo le parole in ordine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase. Tente de novo mantendo as palavras na ordem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna. Probeer het opnieuw en houd de woorden op volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie. Spróbuj jeszcze raz, zachowując kolejność słów."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästan. Försök igen och håll orden i ordning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az kaldı. Kelimelerin sırasını koruyarak tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти. Попробуйте ещё раз, сохраняя порядок слов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майже. Спробуйте ще раз, зберігаючи порядок слів."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग। शब्दों का क्रम बनाए रखते हुए फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتربت. حاول مجددًا مع الحفاظ على ترتيب الكلمات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "惜しい。言葉の順番を守って、もう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 다 왔어요. 단어 순서를 지켜서 다시 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差一点。按顺序再说一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hampir. Coba lagi, jaga urutan kata-katanya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malapit na. Subukan ulit, sunod-sunod ang mga salita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần đúng rồi. Thử lại, giữ đúng thứ tự các từ."
          }
        }
      }
    },
