    "So it isn't a talent problem.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así que no es un problema de talento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est donc pas une question de talent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist also kein Talentproblem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quindi non è un problema di talento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Então não é um problema de talento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is dus geen kwestie van talent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To więc nie problem talentu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så det handlar inte om talang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yani bu bir yetenek sorunu değil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значит, дело не в таланте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отже, справа не в таланті."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तो यह प्रतिभा की समस्या नहीं है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن ليست مشكلة موهبة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つまり、才能の問題ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러니 재능의 문제가 아니에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所以这不是天赋的问题。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadi ini bukan soal bakat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaya hindi ito problema ng talento."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vậy đây không phải vấn đề năng khiếu."
          }
        }
      }
    },
    "So, what do you do?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y tú, ¿a qué te dedicas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alors, tu fais quoi dans la vie ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und, was machst du so?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allora, di cosa ti occupi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E aí, o que você faz?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "En, wat doe jij?"
