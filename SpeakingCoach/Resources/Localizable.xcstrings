            "state": "translated",
            "value": "Przedstawianie się, small talk i mówienie tego, co myślisz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentationer, småprat och att säga vad du menar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanışmalar, sohbetler ve ne demek istediğini söylemek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знакомства, светская беседа и умение сказать, что думаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайомства, світська бесіда й уміння сказати, що думаєте."
          }
        },
        "hi": {
