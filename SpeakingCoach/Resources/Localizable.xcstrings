    "Say it out loud first, so the real time is the second time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo primero en voz alta, para que la vez real sea la segunda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-le d'abord à voix haute, pour que le vrai moment soit la deuxième fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es zuerst laut, damit der echte Moment das zweite Mal ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dillo prima ad alta voce, così la volta vera sarà la seconda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga primeiro em voz alta, para que a vez real seja a segunda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg het eerst hardop, zodat het echte moment de tweede keer is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to najpierw na głos, żeby prawdziwa sytuacja była tą drugą."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg det högt först, så att det riktiga tillfället blir andra gången."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce sesli söyle ki gerçek an ikinci seferin olsun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала скажите это вслух, чтобы настоящий раз был вторым."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу скажіть це вголос, щоб справжній раз був другим."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इसे ज़ोर से कहें, ताकि असली मौका दूसरी बार हो।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلها بصوت عالٍ أولًا، لتكون المرة الحقيقية هي الثانية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず声に出して言っておけば、本番は二回目になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 소리 내어 말해 보면, 실제 순간은 두 번째가 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先大声说一遍，这样真正上场时就是第二次了。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan dengan suara keras dulu, jadi saat sebenarnya adalah kali kedua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin muna nang malakas, para pangalawang beses na ang totoong pagkakataon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói thành tiếng trước, để lúc thật là lần thứ hai."
          }
        }
      }
    },
    "Say this out loud, calmly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo en voz alta, con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis ceci à voix haute, calmement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag das laut und ruhig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dillo ad alta voce, con calma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga isto em voz alta, com calma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg dit hardop, rustig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to na głos, spokojnie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg det här högt, lugnt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu sesli ve sakin söyle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите это вслух, спокойно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть це вголос, спокійно."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे ज़ोर से, शांति से कहें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل هذا بصوت عالٍ، بهدوء."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いて声に出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차분하게 소리 내어 말해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平静地大声说出来。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan ini dengan suara keras, dengan tenang."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabihin ito nang malakas, nang kalmado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói câu này thành tiếng, bình tĩnh."
          }
        }
      }
    },
    "Say this out loud, like you mean it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo en voz alta, con convicción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis ceci à voix haute, avec conviction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag das laut, als ob du es meinst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dillo ad alta voce, con convinzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga isto em voz alta, com convicção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg dit hardop, alsof je het meent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to na głos, z przekonaniem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg det här högt, som om du menar det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu sesli ve inanarak söyle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите это вслух, с убеждённостью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть це вголос, переконано."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे ज़ोर से, पूरे यकीन से कहें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل هذا بصوت عالٍ، بثقة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気持ちを込めて声に出してください。"
