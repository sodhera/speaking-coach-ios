    "Your manager wants an update. Right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu jefe quiere una actualización. Ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton manager veut un point. Tout de suite."
          }
        },
