    "What's something small you did recently that you're proud of?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cosa pequeña hiciste hace poco de la que te sientes orgulloso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle petite chose as-tu faite récemment dont tu es fier ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf welche Kleinigkeit, die du neulich gemacht hast, bist du stolz?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è una piccola cosa che hai fatto di recente e di cui sei orgoglioso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que coisa pequena você fez recentemente e da qual se orgulha?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op welk klein ding dat je onlangs deed ben je trots?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z jakiej drobnej rzeczy, którą ostatnio zrobiono, jesteś dumny?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken liten sak har du gjort nyligen som du är stolt över?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son zamanlarda yaptığın ve gurur duyduğun küçük bir şey nedir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой небольшой поступок из недавних вызывает у вас гордость?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яким невеликим недавнім вчинком ви пишаєтеся?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल में आपने कौन-सा छोटा काम किया जिस पर आपको गर्व है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الشيء الصغير الذي فعلته مؤخرًا وتفخر به؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近した、小さくても誇らしいことは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 한 작지만 뿌듯한 일은 무엇인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近做过哪件让你骄傲的小事？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa hal kecil yang baru-baru ini kamu lakukan dan kamu banggakan?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Anong maliit na bagay ang ginawa mo kamakailan na ipinagmamalaki mo?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần đây bạn đã làm một việc nhỏ nào khiến bạn tự hào?"
          }
        }
      }
    },
    "What's up?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qu'il y a ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was gibt's?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che succede?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E aí?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is er?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co słychać?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad är det?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что случилось?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що сталося?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या बात है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الأمر؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どうしたの？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무슨 일이에요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怎么了？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada apa?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano'ng meron?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có chuyện gì vậy?"
          }
        }
      }
    },
    "When I slow down, people listen more closely.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando voy más despacio, la gente escucha con más atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand je ralentis, les gens écoutent plus attentivement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich langsamer werde, hören die Leute genauer zu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando rallento, le persone ascoltano con più attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desacelero, as pessoas escutam com mais atenção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ik vertraag, luisteren mensen beter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy zwalniam, ludzie słuchają uważniej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När jag saktar ner lyssnar folk mer noga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaşladığımda insanlar daha dikkatli dinliyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда я замедляюсь, люди слушают внимательнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли я сповільнююся, люди слухають уважніше."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब मैं धीमा होता हूँ, लोग ज़्यादा ध्यान से सुनते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين أبطئ، يصغي الناس أكثر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり話すと、人はもっと注意深く聞いてくれる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 말하면 사람들이 더 귀 기울여 들어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当我放慢语速，别人会听得更认真。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat saya melambat, orang mendengarkan lebih saksama."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag bumabagal ako, mas nakikinig nang mabuti ang mga tao."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tôi nói chậm lại, mọi người lắng nghe kỹ hơn."
          }
        }
      }
    },
    "When I'm nervous, I talk too fast or ramble.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando estoy nervioso, hablo demasiado rápido o me enrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand je suis nerveux, je parle trop vite ou je m'éparpille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich nervös bin, rede ich zu schnell oder schweife ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sono nervoso, parlo troppo in fretta o divago."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando fico nervoso, falo rápido demais ou me enrolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als ik zenuwachtig ben, praat ik te snel of dwaal ik af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy się denerwuję, mówię za szybko albo gubię wątek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När jag är nervös pratar jag för fort eller svamlar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerildiğimde çok hızlı konuşur ya da lafı uzatırım."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда я нервничаю, я говорю слишком быстро или ухожу в сторону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли я нервую, я говорю надто швидко або відволікаюся."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घबराने पर मैं बहुत तेज़ बोलता हूँ या भटक जाता हूँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حين أتوتر، أتحدث بسرعة كبيرة أو أُطيل الكلام."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊張すると、早口になったり話がそれたりする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴장하면 말이 너무 빨라지거나 횡설수설해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一紧张，我就说得太快或者东拉西扯。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat gugup, saya bicara terlalu cepat atau bertele-tele."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag kinakabahan ako, masyado akong mabilis magsalita o paligoy-ligoy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lo lắng, tôi nói quá nhanh hoặc lan man."
          }
        }
      }
    },
    "When is it?": {
      "localizations": {
        "es": {
