    "Your account couldn't be deleted. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar tu cuenta. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte n'a pas pu être supprimé. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto konnte nicht gelöscht werden. Bitte versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare il tuo account. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível apagar sua conta. Tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account kon niet worden verwijderd. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć konta. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto kunde inte raderas. Försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın silinemedi. Lütfen tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить аккаунт. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося видалити обліковий запис. Спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता हटाया नहीं जा सका। कृपया दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف حسابك. يُرجى المحاولة مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제하지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除你的账户。请重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akunmu tidak bisa dihapus. Silakan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabura ang account mo. Pakisubukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa tài khoản của bạn. Vui lòng thử lại."
          }
        }
      }
    },
