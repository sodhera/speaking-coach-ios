    "Restore didn't finish. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración no terminó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration n'a pas abouti. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung wurde nicht abgeschlossen. Bitte versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino non è stato completato. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração não foi concluída. Tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen is niet voltooid. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie nie zostało dokończone. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställningen blev inte klar. Försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme tamamlanmadı. Lütfen tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление не завершено. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення не завершено. Спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहाली पूरी नहीं हुई। कृपया दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل الاستعادة. يُرجى المحاولة مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元が完了しませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 완료되지 않았어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复未完成。请重试。"
          }
        },
