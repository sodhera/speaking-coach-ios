            "value": "Tôi đã dùng điều mình luyện tập"
          }
        }
      }
    },
    "I'd like to talk about my pay. This year I took on the launch and grew it 30%.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me gustaría hablar de mi salario. Este año me encargué del lanzamiento y lo hice crecer un 30 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'aimerais parler de mon salaire. Cette année, j'ai pris en charge le lancement et je l'ai fait progresser de 30 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich möchte über mein Gehalt sprechen. Dieses Jahr habe ich den Launch übernommen und ihn um 30 % gesteigert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorrei parlare del mio stipendio. Quest'anno ho seguito il lancio e l'ho fatto crescere del 30%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de falar sobre meu salário. Este ano assumi o lançamento e o fiz crescer 30%."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil het graag over mijn salaris hebben. Dit jaar nam ik de lancering op me en liet die met 30% groeien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chciałbym porozmawiać o wynagrodzeniu. W tym roku przejąłem premierę i zwiększyłem wyniki o 30%."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag skulle vilja prata om min lön. I år tog jag hand om lanseringen och fick den att växa med 30 %."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaşım hakkında konuşmak istiyorum. Bu yıl lansmanı üstlendim ve %30 büyüttüm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я хотел бы обсудить свою зарплату. В этом году я взял на себя запуск и увеличил показатели на 30%."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я хотів би обговорити свою зарплату. Цього року я взяв на себе запуск і збільшив показники на 30%."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं अपने वेतन के बारे में बात करना चाहता हूँ। इस साल मैंने लॉन्च सँभाला और उसे 30% बढ़ाया।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أودّ الحديث عن راتبي. هذا العام توليت الإطلاق ونمّيته بنسبة 30٪."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与についてお話しさせてください。今年はローンチを担当し、30%成長させました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연봉에 대해 이야기하고 싶어요. 올해 출시를 맡아 30% 성장시켰어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想谈谈我的薪资。今年我负责了产品发布，并实现了30%的增长。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya ingin membicarakan gaji saya. Tahun ini saya memegang peluncuran dan menumbuhkannya 30%."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusto kong pag-usapan ang sahod ko. Ngayong taon, hinawakan ko ang launch at pinalago ito nang 30%."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi muốn trao đổi về mức lương. Năm nay tôi phụ trách đợt ra mắt và tăng trưởng 30%."
          }
        }
      }
    },
    "I'll look around first": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiero echar un vistazo primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vais d'abord jeter un œil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schaue mich erst um"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima do un'occhiata in giro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou dar uma olhada primeiro"
          }
        },
        "nl": {
