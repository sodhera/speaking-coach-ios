            "state": "translated",
            "value": "你目前说的话已保存。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sudah kamu ucapkan sejauh ini tersimpan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save ang lahat ng sinabi mo hanggang ngayon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn nói đến giờ đã được lưu."
          }
        }
      }
    },
    "What's a book, show, or place you'd recommend, and what makes it good?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué libro, serie o lugar recomendarías, y qué lo hace bueno?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel livre, série ou lieu recommanderais-tu, et pourquoi est-ce bien ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Buch, welche Serie oder welchen Ort würdest du empfehlen, und was macht es gut?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale libro, serie o posto consiglieresti, e cosa lo rende valido?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que livro, série ou lugar você recomendaria, e o que o torna bom?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk boek, welke serie of plek zou je aanraden, en wat maakt het goed?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaką książkę, serial lub miejsce poleciłbyś i co czyni je dobrym?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken bok, serie eller plats skulle du rekommendera, och vad gör den bra?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi kitabı, diziyi ya da yeri önerirsin ve onu iyi yapan ne?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какую книгу, сериал или место вы бы порекомендовали и чем они хороши?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яку книжку, серіал чи місце ви б порекомендували і чим вони хороші?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कौन-सी किताब, शो या जगह सुझाएँगे, और वह अच्छी क्यों है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الكتاب أو المسلسل أو المكان الذي تنصح به، وما الذي يجعله جيدًا؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの本、番組、場所はどこで、何が良いですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천하고 싶은 책, 프로그램, 장소와 그 이유는 무엇인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会推荐哪本书、哪部剧或哪个地方？它好在哪里？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku, acara, atau tempat apa yang ingin kamu rekomendasikan, dan apa yang membuatnya bagus?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Anong libro, palabas, o lugar ang irerekomenda mo, at bakit ito maganda?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cuốn sách, chương trình hay địa điểm bạn muốn giới thiệu là gì, và điều gì làm nó hay?"
          }
        }
      }
    },
    "What's an opinion you hold that many people disagree with?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué opinión tienes con la que mucha gente no está de acuerdo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle opinion as-tu que beaucoup de gens ne partagent pas ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Meinung vertrittst du, der viele widersprechen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale tua opinione non è condivisa da molte persone?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que opinião você tem com a qual muita gente discorda?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke mening heb jij waar veel mensen het niet mee eens zijn?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie masz zdanie, z którym wiele osób się nie zgadza?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken åsikt har du som många inte håller med om?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birçok insanın katılmadığı hangi görüşe sahipsin?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое ваше мнение многие не разделяют?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яку вашу думку багато хто не поділяє?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ऐसी कौन-सी राय है जिससे बहुत से लोग असहमत हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الرأي الذي تتبناه ويخالفك فيه كثيرون؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの人が賛成しない、あなたの意見は何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 사람이 동의하지 않는 당신의 의견은 무엇인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有什么观点是很多人不同意的？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa pendapatmu yang tidak disetujui banyak orang?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Anong opinyon mo ang hindi sinasang-ayunan ng marami?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quan điểm của bạn mà nhiều người không đồng ý là gì?"
          }
        }
      }
    },
    "What's coming up?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se acerca?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui approche ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was steht an?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa si avvicina?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está chegando?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat komt eraan?"
          }
        },
        "pl": {
