    "Can I add one thing? We're missing the cost side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo añadir algo? Nos falta la parte de costes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux ajouter une chose ? Il nous manque l'aspect des coûts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf ich noch etwas ergänzen? Uns fehlt die Kostenseite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso aggiungere una cosa? Ci manca la parte dei costi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso acrescentar uma coisa? Está faltando a parte de custos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag ik nog één ding toevoegen? We missen de kostenkant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogę coś dodać? Brakuje nam strony kosztowej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Får jag lägga till en sak? Vi saknar kostnadssidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey ekleyebilir miyim? Maliyet tarafını atlıyoruz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно я добавлю? Мы упускаем расходы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна я додам? Ми оминаємо витрати."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या मैं एक बात जोड़ सकता हूँ? हम लागत वाला पहलू छोड़ रहे हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنني إضافة أمر واحد؟ ينقصنا جانب التكلفة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つ付け加えてもいいですか？コスト面が抜けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 덧붙여도 될까요? 비용 측면이 빠져 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我能补充一点吗？我们漏掉了成本方面。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh saya tambahkan satu hal? Sisi biayanya belum dibahas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede ba akong magdagdag ng isang bagay? Kulang tayo sa usapang gastos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi bổ sung một ý được không? Chúng ta đang bỏ sót phần chi phí."
          }
        }
      }
    },
