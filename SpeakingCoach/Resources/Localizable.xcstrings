    "Here you can try that kind of moment again, at your own pace.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes volver a probar ese tipo de momento, a tu ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, tu peux rejouer ce genre de moment, à ton rythme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kannst du so einen Moment noch einmal üben, in deinem Tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui puoi riprovare quel tipo di momento, al tuo ritmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você pode tentar esse tipo de momento de novo, no seu ritmo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier kun je zo'n moment opnieuw proberen, in je eigen tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu możesz spróbować takiej sytuacji jeszcze raz, w swoim tempie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här kan du prova den sortens ögonblick igen, i din egen takt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada böyle bir anı kendi hızında tekrar deneyebilirsin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь можно заново попробовать такой момент в своём темпе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут можна знову спробувати такий момент у своєму темпі."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आप ऐसे पल को अपनी रफ़्तार से फिर आज़मा सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هنا يمكنك تجربة لحظة كهذه مجددًا على راحتك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは、そんな場面を自分のペースでもう一度試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 그런 순간을 내 속도대로 다시 시도할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里，你可以按自己的节奏，再经历一次那样的时刻。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di sini kamu bisa mencoba momen seperti itu lagi, sesuai kecepatanmu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito, puwede mong subukan ulit ang ganoong sandali, sa sarili mong bilis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây bạn có thể thử lại khoảnh khắc như vậy, theo nhịp của bạn."
          }
        }
      }
    },
