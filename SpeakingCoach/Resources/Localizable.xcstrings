    "Choose any that fit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige todas las que encajen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis toutes celles qui correspondent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alle, die passen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tutte quelle adatte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha todas as que se aplicam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies alles wat past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wszystkie pasujące."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj alla som passar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanların hepsini seç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите всё, что подходит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть усе, що підходить."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो भी लागू हों, चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كل ما ينطبق."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当てはまるものをすべて選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당하는 것을 모두 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择所有符合的选项。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih yang sesuai."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin lahat ng tugma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tất cả những gì phù hợp."
          }
        }
      }
    },
    "Choose apps that pull you away. During your window they stay shut until you say one thing out loud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las apps que te distraen. Durante tu franja se quedan cerradas hasta que digas algo en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les apps qui te détournent. Pendant ton créneau, elles restent fermées jusqu'à ce que tu dises une chose à voix haute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Apps, die dich ablenken. In deinem Zeitfenster bleiben sie gesperrt, bis du etwas laut sagst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le app che ti distraggono. Nella tua fascia oraria restano chiuse finché non dici una cosa ad alta voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os apps que te distraem. No seu horário, eles ficam fechados até você dizer algo em voz alta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies apps die je afleiden. Tijdens je tijdvak blijven ze dicht tot je iets hardop zegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikacje, które cię rozpraszają. W twoich godzinach pozostaną zamknięte, dopóki nie powiesz czegoś na głos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj appar som drar iväg dig. Under ditt tidsfönster förblir de stängda tills du säger något högt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkatini dağıtan uygulamaları seç. Belirlediğin saatlerde, sesli bir şey söyleyene kadar kapalı kalırlar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите отвлекающие приложения. В ваше время они будут закрыты, пока вы не скажете что-нибудь вслух."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть програми, які відволікають. У ваш час вони будуть закриті, доки ви не скажете щось уголос."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान भटकाने वाले ऐप चुनें। आपके तय समय में वे तब तक बंद रहेंगे जब तक आप कुछ ज़ोर से नहीं बोलते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التطبيقات التي تشتّت انتباهك. خلال الفترة التي تحددها تبقى مغلقة حتى تقول شيئًا بصوت عالٍ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気が散るアプリを選びましょう。設定した時間帯は、何か声に出して話すまで開けなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자꾸 손이 가는 앱을 고르세요. 설정한 시간 동안에는 소리 내어 한마디 할 때까지 열리지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择会让你分心的 App。在设定的时间段内，它们会保持锁定，直到你大声说一句话。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih app yang sering mengalihkan perhatianmu. Selama jendela waktumu, app itu tetap terkunci sampai kamu mengucapkan sesuatu dengan suara keras."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang apps na umaagaw ng atensyon mo. Sa takdang oras mo, mananatili silang sarado hanggang may sabihin ka nang malakas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những ứng dụng khiến bạn xao nhãng. Trong khung giờ của bạn, chúng sẽ bị khóa cho đến khi bạn nói một điều thành tiếng."
          }
        }
      }
    },
