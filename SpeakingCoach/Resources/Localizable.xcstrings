    "A stranger stops you to chat. Don't freeze.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desconocido te para a charlar. No te bloquees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inconnu t'arrête pour discuter. Ne te fige pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine fremde Person spricht dich an. Erstarre nicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno sconosciuto ti ferma per chiacchierare. Non bloccarti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um desconhecido para você para conversar. Não trave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vreemde spreekt je aan. Bevries niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieznajomy zagaduje cię na ulicy. Nie zamieraj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En främling stannar dig för att prata. Frys inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yabancı sohbet etmek için seni durduruyor. Donup kalma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Незнакомец останавливает вас поболтать. Не замирайте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Незнайомець зупиняє вас поговорити. Не завмирайте."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अजनबी बात करने के लिए रोकता है। अटकें नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غريب يوقفك للدردشة. لا تتجمّد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見知らぬ人に話しかけられます。固まらないで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낯선 사람이 말을 걸어요. 얼어붙지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人拦住你聊天。别愣住。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang asing mengajakmu mengobrol. Jangan membeku."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May estrangherong kumausap sa iyo. Huwag kang matigilan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người lạ bắt chuyện với bạn. Đừng đứng hình."
          }
        }
      }
    },
