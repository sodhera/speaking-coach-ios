    "Five sessions that build to your date": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco sesiones que te preparan para tu fecha"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq séances qui mènent à ta date"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Einheiten, die auf deinen Termin hinführen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque sessioni che ti portano alla tua data"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco sessões que levam até a sua data"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf sessies die naar je datum toewerken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć sesji, które prowadzą do twojej daty"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem sessioner som bygger upp till ditt datum"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihine doğru ilerleyen beş oturum"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять сессий, которые подводят к вашей дате"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "П'ять сесій, що підводять до вашої дати"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच सेशन जो आपकी तारीख तक ले जाते हैं"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خمس جلسات تُمهّد لموعدك"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定日に向けて積み上げる5つのセッション"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜에 맞춰 쌓아 가는 다섯 번의 세션"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的日子逐步准备的五次练习"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima sesi yang membangun menuju hari-H"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limang session na naghahanda sa iyo para sa petsa mo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Năm buổi chuẩn bị dần cho ngày của bạn"
          }
        }
      }
    },
    "Five sessions, in the order that builds. Add a date if something's coming up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco sesiones, en el orden que te hace avanzar. Añade una fecha si se acerca algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq séances, dans l'ordre qui fait progresser. Ajoute une date si quelque chose approche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Einheiten in der Reihenfolge, die aufeinander aufbaut. Füge ein Datum hinzu, wenn etwas ansteht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque sessioni, nell'ordine che ti fa crescere. Aggiungi una data se si avvicina qualcosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco sessões, na ordem que faz você evoluir. Adicione uma data se algo estiver chegando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf sessies, in de volgorde die opbouwt. Voeg een datum toe als er iets aankomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć sesji w kolejności, która buduje umiejętności. Dodaj datę, jeśli coś się zbliża."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem sessioner, i den ordning som bygger upp. Lägg till ett datum om något är på gång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirinin üzerine inşa edilen sırayla beş oturum. Yaklaşan bir şey varsa tarih ekle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять сессий в порядке, который развивает навык. Добавьте дату, если что-то приближается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "П'ять сесій у порядку, який розвиває навичку. Додайте дату, якщо щось наближається."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच सेशन, उसी क्रम में जिससे हुनर बनता है। अगर कुछ आने वाला है तो तारीख जोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خمس جلسات بترتيب يبني المهارة. أضف تاريخًا إن كان هناك شيء قادم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力がつく順番で5つのセッション。予定があれば日付を追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실력이 쌓이는 순서로 다섯 번의 세션. 다가오는 일정이 있다면 날짜를 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五次练习，按循序渐进的顺序。如果有事即将到来，请添加日期。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima sesi, dalam urutan yang bertahap. Tambahkan tanggal jika ada sesuatu yang akan datang."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limang session, sa pagkakasunod na nagpapalakas. Magdagdag ng petsa kung may paparating."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Năm buổi, theo thứ tự tăng dần. Thêm ngày nếu có sự kiện sắp tới."
          }
        }
      }
    },
