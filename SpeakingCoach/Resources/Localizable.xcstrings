    "That conversation, out loud, before it happens for real.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa conversación, en voz alta, antes de que ocurra de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation, à voix haute, avant qu'elle ait lieu pour de vrai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gespräch, laut, bevor es wirklich passiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella conversazione, ad alta voce, prima che succeda davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa conversa, em voz alta, antes de acontecer de verdade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat gesprek, hardop, voordat het echt gebeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rozmowa, na głos, zanim wydarzy się naprawdę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det samtalet, högt, innan det händer på riktigt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O konuşma, sesli olarak, gerçekten olmadan önce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот разговор вслух — до того, как он случится на самом деле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця розмова вголос — до того, як вона станеться насправді."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह बातचीत, ज़ोर से, असल में होने से पहले।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلك المحادثة، بصوت عالٍ، قبل أن تحدث فعلًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その話し合いを、本番の前に声に出して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 대화를, 실제로 일어나기 전에 소리 내어."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在那场对话真正发生前，先大声练一遍。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan itu, dengan suara keras, sebelum terjadi sungguhan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang usapang iyon, nang malakas, bago pa ito mangyari nang totoo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện đó, thành tiếng, trước khi nó diễn ra thật."
          }
        }
      }
    },
    "That couldn't be checked right now. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier pour le moment. Réessaie dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte gerade nicht geprüft werden. Versuch es gleich noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile controllare ora. Riprova tra un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar agora. Tente de novo em instantes."
          }
        },
