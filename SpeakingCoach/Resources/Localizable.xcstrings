          "stringUnit": {
            "state": "translated",
            "value": "Du bist im Meeting anderer Meinung. Sag es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei d'accordo in riunione. Dillo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você discorda numa reunião. Diga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent het oneens in een vergadering. Zeg het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zgadzasz się na spotkaniu. Powiedz to."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du håller inte med på ett möte. Säg det."
