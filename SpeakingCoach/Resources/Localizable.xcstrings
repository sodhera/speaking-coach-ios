    "Retry the moment in practice, not in your head at 2am.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite el momento practicando, no en tu cabeza a las 2 de la madrugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoue le moment à l'entraînement, pas dans ta tête à 2 h du matin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole den Moment beim Üben, nicht nachts um 2 im Kopf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova il momento allenandoti, non nella tua testa alle 2 di notte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita o momento na prática, não na sua cabeça às 2 da manhã."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het moment opnieuw tijdens het oefenen, niet om 2 uur 's nachts in je hoofd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtórz ten moment podczas ćwiczeń, a nie w głowie o 2 w nocy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör om ögonblicket under övning, inte i huvudet klockan två på natten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anı gece 2'de kafanda değil, pratikte tekrarla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите момент на практике, а не в голове в два часа ночи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторіть момент на практиці, а не в голові о другій ночі."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस पल को अभ्यास में दोहराएँ, रात 2 बजे अपने मन में नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعِد اللحظة في التدرّب، لا في رأسك في الثانية فجرًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深夜2時に頭の中でではなく、練習でその瞬間をやり直しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 2시 머릿속이 아니라, 연습에서 그 순간을 다시 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在练习中重来那一刻，而不是凌晨两点在脑子里重演。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi momennya saat latihan, bukan di kepalamu jam 2 pagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulitin ang sandali sa practice, hindi sa isip mo nang alas-2 ng madaling-araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại khoảnh khắc đó khi luyện tập, chứ không phải trong đầu lúc 2 giờ sáng."
          }
        }
      }
    },
