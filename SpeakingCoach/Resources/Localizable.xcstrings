        }
      }
    },
    "We signed you in instead. Your plan and progress are just as you left them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su lugar, hemos iniciado tu sesión. Tu plan y tu progreso están tal como los dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On t'a connecté à la place. Ton plan et tes progrès sont exactement comme tu les as laissés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben dich stattdessen angemeldet. Dein Plan und dein Fortschritt sind genau so, wie du sie verlassen hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti abbiamo fatto accedere. Il tuo piano e i tuoi progressi sono esattamente come li avevi lasciati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez disso, fizemos seu login. Seu plano e seu progresso estão exatamente como você deixou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je in plaats daarvan ingelogd. Je plan en voortgang zijn precies zoals je ze achterliet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast tego zalogowaliśmy cię. Twój plan i postępy są dokładnie takie, jak je zostawiono."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi loggade in dig i stället. Din plan och dina framsteg är precis som du lämnade dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine seni giriş yaptık. Planın ve ilerlemen bıraktığın gibi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого мы выполнили вход. Ваш план и прогресс такие же, как вы их оставили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натомість ми виконали вхід. Ваш план і прогрес такі самі, як ви їх залишили."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने इसके बजाय आपको साइन इन कर दिया। आपका प्लान और प्रगति वैसे ही हैं जैसे आपने छोड़े थे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلنا دخولك بدلًا من ذلك. خطتك وتقدمك كما تركتهما تمامًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりにサインインしました。プランも進捗もそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 로그인해 드렸어요. 플랜과 진행 상황은 그대로예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已为你直接登录。你的计划和进度都还在。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memasukkanmu ke akun yang ada. Paket dan progresmu tetap sama."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-sign in ka na lang namin. Nandiyan pa rin ang plan at progreso mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã đăng nhập cho bạn. Kế hoạch và tiến độ vẫn nguyên như cũ."
          }
        }
      }
    },
    "We'll give you a place to say it out loud before the real conversation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te daremos un lugar donde decirlo en voz alta antes de la conversación real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te donnera un endroit pour le dire à voix haute avant la vraie conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir geben dir einen Ort, um es vor dem echten Gespräch laut zu sagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti daremo un posto dove dirlo ad alta voce prima della conversazione vera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos te dar um lugar para dizer isso em voz alta antes da conversa real."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We geven je een plek om het hardop te zeggen voor het echte gesprek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Damy ci miejsce, by powiedzieć to na głos przed prawdziwą rozmową."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ger dig en plats att säga det högt före det riktiga samtalet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek konuşmadan önce sesli söyleyebileceğin bir yer sunacağız."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы дадим вам место, чтобы сказать это вслух до настоящего разговора."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми дамо вам місце, щоб сказати це вголос до справжньої розмови."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको असली बातचीत से पहले इसे ज़ोर से कहने की जगह देंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنمنحك مكانًا لتقولها بصوت عالٍ قبل المحادثة الحقيقية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本番の前に、声に出して言える場所を用意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 대화 전에 소리 내어 말해 볼 공간을 드릴게요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会给你一个地方，在真正的对话之前先大声说出来。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan memberimu tempat untuk mengucapkannya dengan suara keras sebelum percakapan sebenarnya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibigyan ka namin ng lugar para sabihin ito nang malakas bago ang totoong usapan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ cho bạn một nơi để nói thành tiếng trước cuộc trò chuyện thật."
          }
        }
      }
    },
    "We'll help you make one good answer even clearer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ayudaremos a que una buena respuesta sea aún más clara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On t'aidera à rendre une bonne réponse encore plus claire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir helfen dir, eine gute Antwort noch klarer zu machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti aiuteremo a rendere una buona risposta ancora più chiara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos te ajudar a deixar uma boa resposta ainda mais clara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We helpen je één goed antwoord nog duidelijker te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomożemy ci sprawić, by dobra odpowiedź była jeszcze jaśniejsza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hjälper dig att göra ett bra svar ännu tydligare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi bir yanıtı daha da netleştirmene yardım edeceğiz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы поможем сделать хороший ответ ещё яснее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми допоможемо зробити хорошу відповідь ще чіткішою."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम एक अच्छे जवाब को और भी साफ़ बनाने में मदद करेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنساعدك لتجعل إجابة جيدة أوضح."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良い答えを、さらに明確にするお手伝いをします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 답변을 한층 더 명확하게 다듬도록 도와드릴게요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会帮你把一个好回答变得更清楚。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan membantumu membuat satu jawaban yang bagus jadi lebih jelas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutulungan ka naming gawing mas malinaw pa ang isang magandang sagot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ giúp bạn làm một câu trả lời hay trở nên rõ ràng hơn nữa."
          }
        }
      }
    },
    "We'll practice finding your main point and saying it clearly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practicaremos a encontrar tu idea principal y decirla con claridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On s'entraînera à trouver ton idée principale et à la dire clairement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir üben, deinen Hauptpunkt zu finden und ihn klar zu sagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci alleneremo a trovare il tuo punto principale e a dirlo chiaramente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos praticar encontrar sua ideia principal e dizê-la com clareza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We oefenen om je hoofdpunt te vinden en het duidelijk te zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przećwiczymy znajdowanie głównej myśli i mówienie jej jasno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi övar på att hitta din huvudpoäng och säga den tydligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana fikrini bulup net söylemeyi çalışacağız."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будем отрабатывать, как найти главную мысль и сказать её ясно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпрацьовуватимемо, як знайти головну думку й сказати її чітко."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी मुख्य बात ढूँढकर उसे साफ़ कहने का अभ्यास करेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتدرّب على إيجاد فكرتك الرئيسية وقولها بوضوح."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要点を見つけて、はっきり伝える練習をします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요점을 찾고 명확하게 말하는 연습을 할 거예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会练习找到你的核心观点，并把它讲清楚。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita akan berlatih menemukan poin utamamu dan mengucapkannya dengan jelas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipa-practice natin ang paghahanap ng pangunahing punto mo at pagsasabi nito nang malinaw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta sẽ luyện tìm ý chính và nói nó thật rõ ràng."
          }
        }
      }
    },
    "We'll practice one question at a time, with room to find your words.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practicaremos una pregunta cada vez, con espacio para encontrar tus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On s'entraînera une question à la fois, en te laissant le temps de trouver tes mots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir üben eine Frage nach der anderen, mit Raum, deine Worte zu finden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci alleneremo una domanda alla volta, con lo spazio per trovare le parole."
