        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "No to czym się zajmujesz?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så, vad jobbar du med?"
          }
        },
        "tr": {
          "stringUnit": {
