    "Answer out loud, like you would on the day. Each answer gets one specific note.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde en voz alta, como lo harías ese día. Cada respuesta recibe un comentario concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds à voix haute, comme le jour J. Chaque réponse reçoit un conseil précis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte laut, so wie am Tag selbst. Jede Antwort bekommt einen konkreten Hinweis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi ad alta voce, come faresti quel giorno. Ogni risposta riceve un consiglio preciso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda em voz alta, como faria no dia. Cada resposta recebe uma observação específica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoord hardop, zoals je dat op de dag zelf zou doen. Elk antwoord krijgt één concrete tip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na głos, tak jak w tym dniu. Każda odpowiedź dostaje jedną konkretną uwagę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara högt, som du skulle på dagen. Varje svar får en konkret kommentar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O gün nasıl yanıtlayacaksan öyle sesli yanıtla. Her yanıt belirli bir not alır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечайте вслух, как в тот самый день. Каждый ответ получит одно конкретное замечание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідайте вголос, як того самого дня. Кожна відповідь отримає одне конкретне зауваження."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी दिन की तरह ज़ोर से जवाब दें। हर जवाब पर एक खास सुझाव मिलेगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب بصوت عالٍ كما ستفعل في ذلك اليوم. تحصل كل إجابة على ملاحظة محددة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本番の日のつもりで声に出して答えましょう。答えごとに具体的なアドバイスが一つ届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 그날처럼 소리 내어 답해 보세요. 답변마다 구체적인 조언을 하나씩 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像正式那天一样大声回答。每个回答都会得到一条具体建议。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab dengan suara keras, seperti pada hari-H. Setiap jawaban mendapat satu saran spesifik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumagot nang malakas, gaya ng gagawin mo sa mismong araw. Bawat sagot ay may isang tiyak na payo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời thành tiếng, như bạn sẽ làm vào ngày đó. Mỗi câu trả lời nhận được một lời khuyên cụ thể."
          }
        }
      }
    },
