    "Your first session is waiting. You can change these anytime.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primera sesión te espera. Puedes cambiar esto cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta première séance t'attend. Tu peux changer ces réglages quand tu veux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine erste Einheit wartet. Du kannst das jederzeit ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prima sessione ti aspetta. Puoi cambiare queste impostazioni quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
