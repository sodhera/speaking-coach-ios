          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khán phòng"
          }
        }
      }
    },
    "The same as when you started. Every session is still there when you want another go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual que al principio. Todas las sesiones siguen ahí cuando quieras otro intento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareil qu'au départ. Chaque séance t'attend quand tu veux réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genauso wie zu Beginn. Jede Einheit ist noch da, wenn du es noch einmal versuchen willst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uguale all'inizio. Ogni sessione è lì quando vuoi riprovare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual ao início. Todas as sessões continuam aí quando quiser tentar de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde als toen je begon. Elke sessie staat klaar als je het nog eens wilt proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak samo jak na początku. Każda sesja czeka, gdy zechcesz spróbować jeszcze raz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma som när du började. Alla sessioner finns kvar när du vill göra ett nytt försök."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başladığınla aynı. Tekrar denemek istediğinde tüm oturumlar orada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так же, как в начале. Все сессии на месте, когда захотите попробовать снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так само, як на початку. Усі сесії на місці, коли захочете спробувати знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत जैसा ही। जब भी आप फिर कोशिश करना चाहें, हर सेशन मौजूद है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كما بدأت. كل جلسة ما زالت هناك حين تريد محاولة أخرى."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初と同じです。もう一度試したくなったら、すべてのセッションがここにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음과 같아요. 다시 해 보고 싶을 때 모든 세션이 그대로 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和开始时一样。想再试的时候，所有练习都还在。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama seperti saat kamu mulai. Setiap sesi masih ada kapan pun kamu ingin mencoba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareho noong nagsimula ka. Nandiyan pa ang bawat session kapag gusto mong subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn như lúc bạn bắt đầu. Mọi buổi tập vẫn ở đó khi bạn muốn thử lại."
          }
        }
      }
    },
    "The same level, so far.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo nivel, por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même niveau, pour l'instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher das gleiche Niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso livello, per ora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo nível, por enquanto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorlopig hetzelfde niveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie ten sam poziom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma nivå, än så länge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik aynı seviye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока тот же уровень."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки той самий рівень."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक वही स्तर।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستوى نفسه حتى الآن."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のところ同じレベルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지는 같은 수준이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前保持同一水平。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Level yang sama, sejauh ini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Parehong antas, sa ngayon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn cùng mức, cho đến giờ."
          }
        }
      }
    },
    "Thirty seconds of speaking a day, and your distracting apps held until you've spoken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treinta segundos de hablar al día, y tus apps que distraen en espera hasta que hayas hablado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trente secondes de parole par jour, et tes apps distrayantes en attente jusqu'à ce que tu aies parlé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreißig Sekunden Sprechen pro Tag, und deine ablenkenden Apps bleiben zu, bis du gesprochen hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenta secondi al giorno di parlato, e le app che ti distraggono in attesa finché non hai parlato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinta segundos de fala por dia, e seus apps que distraem em espera até você falar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dertig seconden per dag praten, en je afleidende apps op pauze tot je hebt gesproken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzydzieści sekund mówienia dziennie, a rozpraszające aplikacje czekają, aż coś powiesz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trettio sekunders prat om dagen, och dina störande appar pausade tills du har pratat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde otuz saniye konuşma; dikkat dağıtan uygulamaların sen konuşana kadar beklemede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тридцать секунд речи в день, а отвлекающие приложения ждут, пока вы не заговорите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тридцять секунд мовлення на день, а програми, що відволікають, чекають, доки ви не заговорите."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ तीस सेकंड बोलना, और ध्यान भटकाने वाले ऐप तब तक रुके रहेंगे जब तक आप बोल न लें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثون ثانية من الحديث يوميًا، وتطبيقاتك المشتّتة معلّقة حتى تتحدث."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日30秒話すこと。話すまで、気が散るアプリはお預けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 30초 말하기. 말하기 전까지 방해되는 앱은 잠겨 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天说话三十秒，说之前让人分心的 App 都会保持锁定。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga puluh detik berbicara sehari, dan app yang mengalihkan perhatian tetap terkunci sampai kamu melakukannya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatlumpung segundo ng pagsasalita araw-araw, at mananatiling sarado ang apps na nakakaabala hangga't hindi mo ito ginagawa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba mươi giây nói mỗi ngày, và các ứng dụng gây xao nhãng sẽ bị khóa cho đến khi bạn nói."
          }
        }
      }
    },
    "This PowerPoint couldn't be converted here. Export it as a PDF (File → Export in PowerPoint or Keynote) and add that instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PowerPoint no se pudo convertir aquí. Expórtalo como PDF (Archivo → Exportar en PowerPoint o Keynote) y añádelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce PowerPoint n'a pas pu être converti ici. Exporte-le en PDF (Fichier → Exporter dans PowerPoint ou Keynote) et ajoute-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese PowerPoint-Datei konnte hier nicht umgewandelt werden. Exportiere sie als PDF (Ablage → Exportieren in PowerPoint oder Keynote) und füge diese hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convertire qui questo PowerPoint. Esportalo in PDF (File → Esporta in PowerPoint o Keynote) e aggiungi quello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível converter este PowerPoint aqui. Exporte como PDF (Arquivo → Exportar no PowerPoint ou Keynote) e adicione-o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze PowerPoint kon hier niet worden omgezet. Exporteer hem als pdf (Archief → Exporteer in PowerPoint of Keynote) en voeg die toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się tu przekonwertować tego pliku PowerPoint. Wyeksportuj go jako PDF (Plik → Eksportuj w PowerPoincie lub Keynote) i dodaj go."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här PowerPoint-filen kunde inte konverteras här. Exportera den som PDF (Arkiv → Exportera i PowerPoint eller Keynote) och lägg till den i stället."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu PowerPoint burada dönüştürülemedi. PDF olarak dışa aktar (PowerPoint ya da Keynote'ta Dosya → Dışa Aktar) ve onu ekle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл PowerPoint не удалось преобразовать здесь. Экспортируйте его в PDF (Файл → Экспорт в PowerPoint или Keynote) и добавьте его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл PowerPoint не вдалося перетворити тут. Експортуйте його в PDF (Файл → Експорт у PowerPoint або Keynote) і додайте його."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह PowerPoint यहाँ बदला नहीं जा सका। इसे PDF के रूप में एक्सपोर्ट करें (PowerPoint या Keynote में फ़ाइल → एक्सपोर्ट) और उसे जोड़ें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحويل ملف PowerPoint هذا هنا. صدّره بصيغة PDF (ملف ← تصدير في PowerPoint أو Keynote) وأضفه بدلًا منه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPowerPointはここで変換できませんでした。PDFとして書き出し（PowerPointまたはKeynoteで ファイル → 書き出す）、そちらを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PowerPoint는 여기서 변환할 수 없었어요. PDF로 내보낸 뒤(PowerPoint나 Keynote에서 파일 → 내보내기) 그 파일을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此转换该 PowerPoint。请导出为 PDF（在 PowerPoint 或 Keynote 中选择文件 → 导出），然后添加它。"
          }
        },
