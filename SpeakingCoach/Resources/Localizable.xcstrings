    "Practice your talk with your own slides, then answer the questions your audience would ask.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica tu charla con tus propias diapositivas y luego responde las preguntas que haría tu público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi à ton discours avec tes propres diapos, puis réponds aux questions que poserait ton public."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe deinen Vortrag mit deinen eigenen Folien und beantworte dann die Fragen, die dein Publikum stellen würde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati sul tuo discorso con le tue slide, poi rispondi alle domande che farebbe il tuo pubblico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique sua fala com seus próprios slides e depois responda às perguntas que seu público faria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen je presentatie met je eigen dia's en beantwoord daarna de vragen die je publiek zou stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przećwicz wystąpienie z własnymi slajdami, a potem odpowiedz na pytania, które zadałaby publiczność."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva ditt tal med dina egna bilder och svara sedan på frågorna publiken skulle ställa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmanı kendi slaytlarınla çalış, sonra dinleyicilerinin soracağı soruları yanıtla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрепетируйте выступление со своими слайдами, а затем ответьте на вопросы, которые задала бы аудитория."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відрепетируйте виступ зі своїми слайдами, а потім дайте відповідь на питання, які поставила б аудиторія."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी स्लाइड के साथ भाषण का अभ्यास करें, फिर उन सवालों के जवाब दें जो आपके श्रोता पूछेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على حديثك بشرائحك، ثم أجب عن الأسئلة التي سيطرحها جمهورك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のスライドでスピーチを練習し、聞き手がしそうな質問に答えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 슬라이드로 발표를 연습하고, 청중이 할 법한 질문에 답해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的幻灯片练习演讲，然后回答听众可能提出的问题。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih pidatomu dengan slide-mu sendiri, lalu jawab pertanyaan yang kemungkinan ditanyakan audiensmu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-practice ang talk mo gamit ang sarili mong slides, tapos sagutin ang mga tanong na malamang itanong ng audience mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện bài nói với trang chiếu của bạn, rồi trả lời những câu khán giả có thể hỏi."
          }
        }
      }
    },
