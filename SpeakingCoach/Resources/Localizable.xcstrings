            "value": "Co się zbliża?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad är på gång?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşan ne var?"
          }
        },
        "ru": {
