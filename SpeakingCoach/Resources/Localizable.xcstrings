    "I can take a breath, choose my words, and say what I mean.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo respirar, elegir mis palabras y decir lo que pienso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux respirer, choisir mes mots et dire ce que je pense."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann durchatmen, meine Worte wählen und sagen, was ich meine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso fare un respiro, scegliere le parole e dire ciò che penso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso respirar, escolher minhas palavras e dizer o que penso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan even ademhalen, mijn woorden kiezen en zeggen wat ik bedoel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogę wziąć oddech, dobrać słowa i powiedzieć, co myślę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kan andas, välja mina ord och säga vad jag menar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir nefes alabilir, sözlerimi seçebilir ve ne demek istediğimi söyleyebilirim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я могу сделать вдох, подобрать слова и сказать, что думаю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я можу вдихнути, дібрати слова й сказати, що думаю."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं साँस ले सकता हूँ, अपने शब्द चुन सकता हूँ और जो मतलब है वह कह सकता हूँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أستطيع أن آخذ نفسًا وأختار كلماتي وأقول ما أعنيه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深呼吸して、言葉を選び、思っていることを伝えられる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨을 고르고, 단어를 고르고, 하고 싶은 말을 할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我能深呼吸，斟酌用词，说出我真正想说的话。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya bisa menarik napas, memilih kata, dan mengatakan apa yang saya maksud."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakahinga ako, nakakapili ng salita, at nasasabi ko ang ibig kong sabihin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có thể hít một hơi, chọn từ ngữ và nói đúng điều mình muốn nói."
          }
        }
      }
    },
    "I can't take that on this week, but I can help next Monday.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana no puedo encargarme de eso, pero puedo ayudarte el lunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas m'en charger cette semaine, mais je peux t'aider lundi prochain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann ich diese Woche nicht übernehmen, aber nächsten Montag kann ich helfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana non posso occuparmene, ma posso aiutarti lunedì prossimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consigo assumir isso esta semana, mas posso ajudar na próxima segunda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat kan ik deze week niet oppakken, maar volgende maandag kan ik helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym tygodniu nie mogę się tym zająć, ale mogę pomóc w przyszły poniedziałek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kan inte ta på mig det den här veckan, men jag kan hjälpa till nästa måndag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta onu üstlenemem ama gelecek pazartesi yardım edebilirim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе я не смогу за это взяться, но могу помочь в следующий понедельник."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього тижня я не візьмуся за це, але можу допомогти наступного понеділка."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस हफ़्ते मैं यह नहीं ले सकता, लेकिन अगले सोमवार मदद कर सकता हूँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أستطيع تولي ذلك هذا الأسبوع، لكن يمكنني المساعدة يوم الاثنين القادم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週は引き受けられませんが、来週の月曜なら手伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에는 맡기 어렵지만, 다음 주 월요일에는 도와드릴 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周我接不了，但下周一我可以帮忙。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak bisa mengambilnya minggu ini, tapi saya bisa bantu Senin depan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ko iyan kaya ngayong linggo, pero matutulungan kita sa susunod na Lunes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần này tôi không nhận thêm được, nhưng thứ Hai tuần sau tôi có thể giúp."
          }
        }
      }
    },
