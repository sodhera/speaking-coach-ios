        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будем отрабатывать по одному вопросу, оставляя время подобрать слова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпрацьовуватимемо по одному питанню, залишаючи час дібрати слова."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम एक-एक सवाल का अभ्यास करेंगे, शब्द ढूँढने के लिए समय देते हुए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتدرّب على سؤال واحد في كل مرة، مع مساحة لتجد كلماتك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言葉を探す時間を取りながら、一問ずつ練習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어를 찾을 여유를 두고, 한 번에 한 질문씩 연습할 거예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会一次练一个问题，留出时间让你找到合适的词。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kita akan berlatih satu pertanyaan sekali waktu, dengan ruang untuk menemukan kata-katamu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isa-isang tanong ang ipa-practice natin, may puwang para mahanap mo ang mga salita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta sẽ luyện từng câu hỏi một, có khoảng lặng để bạn tìm từ."
          }
        }
      }
    },
    "We'll work through this together.": {
      "localizations": {
