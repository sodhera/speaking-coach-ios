    "Speak out loud and swipe through your slides as you go. Afterwards, your audience asks questions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla en voz alta y pasa las diapositivas mientras hablas. Después, tu público hace preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à voix haute et fais défiler tes diapos au fur et à mesure. Ensuite, ton public pose ses questions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich laut und wisch dabei durch deine Folien. Danach stellt dein Publikum Fragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla ad alta voce e scorri le slide man mano. Dopo, il tuo pubblico fa domande."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale em voz alta e passe os slides enquanto fala. Depois, seu público faz perguntas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek hardop en veeg door je dia's terwijl je praat. Daarna stelt je publiek vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów na głos i przesuwaj slajdy w trakcie. Potem publiczność zada pytania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata högt och svep genom bilderna medan du talar. Efteråt ställer publiken frågor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli konuş ve ilerledikçe slaytlarını kaydır. Sonra dinleyicilerin soru sorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите вслух и листайте слайды по ходу. Потом аудитория задаст вопросы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть уголос і гортайте слайди по ходу. Потім аудиторія поставить питання."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ोर से बोलें और बोलते हुए स्लाइड बदलें। बाद में, आपके श्रोता सवाल पूछेंगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث بصوت عالٍ ومرّر شرائحك أثناء الحديث. بعدها يطرح جمهورك الأسئلة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声に出して話しながらスライドをスワイプしましょう。その後、聞き手が質問します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 내어 말하면서 슬라이드를 넘기세요. 그다음 청중이 질문해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大声讲，边讲边滑动幻灯片。之后，听众会提问。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicaralah dengan suara keras dan geser slide-mu sambil berjalan. Setelah itu, audiensmu akan bertanya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsalita nang malakas at i-swipe ang slides mo habang nagsasalita. Pagkatapos, magtatanong ang audience mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói thành tiếng và vuốt qua các trang chiếu khi trình bày. Sau đó, khán giả sẽ đặt câu hỏi."
          }
        }
      }
    },
    "Speak to unlock": {
      "localizations": {
        "es": {
          "stringUnit": {
