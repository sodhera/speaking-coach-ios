            "state": "translated",
            "value": "А чем вы занимаетесь?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "А чим ви займаєтеся?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तो, आप क्या करते हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن، ماذا تعمل؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それで、お仕事は何を？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래서, 무슨 일 하세요?"
