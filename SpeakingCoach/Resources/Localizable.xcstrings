    "Transcribed from your session, so the odd word may be off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito de tu sesión, así que alguna palabra puede no ser exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit à partir de ta séance, donc un mot peut parfois être inexact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deiner Einheit transkribiert, einzelne Wörter können abweichen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascritto dalla tua sessione, quindi qualche parola potrebbe non essere esatta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrito da sua sessão, então alguma palavra pode estar errada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschreven uit je sessie, dus een enkel woord kan afwijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja z sesji, więc pojedyncze słowa mogą się nie zgadzać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriberat från din session, så enstaka ord kan bli fel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumundan yazıya döküldü; bazı kelimeler hatalı olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровано из вашей сессии, поэтому отдельные слова могут быть неточными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розшифровано з вашої сесії, тож окремі слова можуть бути неточними."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेशन से लिखा गया, इसलिए कोई शब्द गलत हो सकता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوب من جلستك، لذا قد تخطئ كلمة هنا أو هناك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションから文字起こししたため、一部の言葉が違っている場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션에서 받아 적은 것이라 일부 단어가 다를 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由练习内容转写而来，个别字词可能有误。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditranskripsi dari sesimu, jadi mungkin ada kata yang meleset."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-transcribe mula sa session mo, kaya maaaring may maling salita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được chép lại từ buổi tập của bạn, nên có thể lệch vài từ."
          }
        }
      }
    },
