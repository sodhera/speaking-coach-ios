    "Afterwards, I replay what I should have said.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, repaso lo que debería haber dicho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après coup, je repense à ce que j'aurais dû dire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterher gehe ich im Kopf durch, was ich hätte sagen sollen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo, ripenso a cosa avrei dovuto dire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, fico repassando o que deveria ter dito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achteraf speel ik af wat ik had moeten zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem w myślach odtwarzam, co powinienem był powiedzieć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efteråt går jag igenom vad jag borde ha sagt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonradan ne söylemem gerektiğini kafamda tekrar tekrar düşünürüm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потом я прокручиваю в голове, что надо было сказать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім я прокручую в голові, що треба було сказати."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद में, मैं सोचता रहता हूँ कि मुझे क्या कहना चाहिए था।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعدها، أظل أعيد في ذهني ما كان ينبغي أن أقوله."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとになって、言うべきだったことを何度も考えてしまう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝나고 나서, 했어야 할 말을 계속 떠올려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事后，我总会反复想自己本该怎么说。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelahnya, saya terus membayangkan apa yang seharusnya saya katakan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagkatapos, paulit-ulit kong iniisip ang dapat sana ay nasabi ko."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó, tôi cứ nghĩ đi nghĩ lại những gì lẽ ra mình nên nói."
          }
        }
      }
    },
