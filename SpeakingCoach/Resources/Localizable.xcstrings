    "I know what I want to say, until I have to say it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé lo que quiero decir, hasta que tengo que decirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sais ce que je veux dire, jusqu'au moment de le dire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich weiß, was ich sagen will, bis ich es sagen muss."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "So cosa voglio dire, finché non devo dirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei o que quero dizer, até a hora de dizer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik weet wat ik wil zeggen, tot ik het moet zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiem, co chcę powiedzieć, dopóki nie muszę tego powiedzieć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag vet vad jag vill säga, tills jag måste säga det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne söylemek istediğimi bilirim, söylemem gerekene kadar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я знаю, что хочу сказать, пока не приходится это говорить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я знаю, що хочу сказати, доки не доводиться це казати."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुझे पता होता है कि क्या कहना है, जब तक कहने की बारी न आए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعرف ما أريد قوله، حتى يحين وقت قوله."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言いたいことはわかっているのに、いざ言う番になると出てこない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 말은 아는데, 막상 말해야 할 때 안 나와요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我知道想说什么，可一到要开口时就说不出来。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tahu apa yang ingin saya katakan, sampai saatnya harus mengatakannya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alam ko ang gusto kong sabihin, hanggang sa oras na para sabihin ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi biết mình muốn nói gì, cho đến lúc phải nói ra."
          }
        }
      }
    },
