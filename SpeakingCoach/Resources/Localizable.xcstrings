            "value": "Nie usłyszeliśmy wystarczająco dużo. Spróbuj jeszcze raz, trochę bliżej telefonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi uppfattade inte tillräckligt. Försök en gång till, lite närmare telefonen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterince duyamadık. Telefona biraz daha yakın bir kez daha dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы расслышали недостаточно. Попробуйте ещё раз, чуть ближе к телефону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми почули замало. Спробуйте ще раз, трохи ближче до телефона."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें पर्याप्त नहीं सुनाई दिया। फ़ोन के थोड़ा पास आकर एक बार और कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نلتقط ما يكفي. حاول مرة أخرى وأنت أقرب قليلًا إلى الهاتف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十分に聞き取れませんでした。もう少し端末に近づいて、もう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충분히 듣지 못했어요. 기기에 조금 더 가까이 대고 한 번 더 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听清楚。请离设备近一点再试一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menangkap cukup banyak. Coba sekali lagi, sedikit lebih dekat ke perangkat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sapat ang narinig namin. Subukan ulit, nang mas malapit nang kaunti sa device."
