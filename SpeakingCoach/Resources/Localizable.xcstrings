    "Change plans or cancel anytime.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de plan o cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change d'abonnement ou résilie quand tu veux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarif wechseln oder jederzeit kündigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia piano o annulla quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude de plano ou cancele quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel van abonnement of zeg op wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień plan lub anuluj w dowolnej chwili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt abonnemang eller avsluta när du vill."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planı istediğin zaman değiştir ya da iptal et."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте план или отменяйте в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінюйте план або скасовуйте будь-коли."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी भी प्लान बदलें या रद्द करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر الخطة أو ألغِها في أي وقت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランの変更や解約はいつでもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 플랜을 변경하거나 취소할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时更改方案或取消。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti paket atau batalkan kapan saja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Palitan ang plan o kanselahin kahit kailan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi gói hoặc hủy bất cứ lúc nào."
          }
        }
      }
    },
