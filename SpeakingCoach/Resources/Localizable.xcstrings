    "Your feedback couldn't be sent. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron enviar tus comentarios. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton avis n'a pas pu être envoyé. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feedback konnte nicht gesendet werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare il tuo feedback. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar seu feedback. Verifique sua conexão e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je feedback kon niet worden verstuurd. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać opinii. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina synpunkter kunde inte skickas. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirimin gönderilemedi. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить отзыв. Проверьте подключение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося надіслати відгук. Перевірте з'єднання й спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ीडबैक भेजा नहीं जा सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرسال ملاحظاتك. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 보내지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的反馈未能发送。请检查网络连接后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukanmu tidak bisa dikirim. Periksa koneksimu dan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi naipadala ang feedback mo. Tingnan ang koneksyon mo at subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi góp ý. Kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
    "Your feedback is on its way. It genuinely shapes what we build next.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comentarios están en camino. De verdad influyen en lo que construimos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton avis est en route. Il influence vraiment ce qu'on construit ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Feedback ist unterwegs. Es prägt wirklich, was wir als Nächstes bauen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo feedback è in arrivo. Influenza davvero ciò che costruiamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu feedback está a caminho. Ele realmente orienta o que construímos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je feedback is onderweg. Het bepaalt echt wat we hierna bouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja opinia jest w drodze. Naprawdę wpływa na to, co budujemy dalej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina synpunkter är på väg. De formar verkligen det vi bygger härnäst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirimin yolda. Sırada ne yapacağımızı gerçekten şekillendiriyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш отзыв уже в пути. Он правда влияет на то, что мы делаем дальше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш відгук уже в дорозі. Він справді впливає на те, що ми робимо далі."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ीडबैक रास्ते में है। यह सच में तय करता है कि हम आगे क्या बनाएँगे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظاتك في طريقها إلينا. إنها تشكّل حقًا ما نبنيه لاحقًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを受け取りました。今後の開発に本当に役立てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견이 전달되고 있어요. 저희가 만드는 것에 정말로 반영돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的反馈正在发送。它确实会影响我们接下来做什么。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukanmu sedang dikirim. Ini benar-benar membentuk apa yang kami bangun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Papunta na ang feedback mo. Talagang hinuhubog nito ang ginagawa namin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Góp ý của bạn đang được gửi. Nó thực sự định hình những gì chúng tôi xây dựng."
          }
        }
      }
    },
