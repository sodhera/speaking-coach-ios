    "It's okay to pause when a question catches you off guard.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está bien hacer una pausa cuando una pregunta te pilla por sorpresa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est normal de marquer une pause quand une question te prend au dépourvu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist okay, kurz innezuhalten, wenn dich eine Frage überrascht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene fermarsi un attimo quando una domanda ti prende alla sprovvista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo bem fazer uma pausa quando uma pergunta te pega de surpresa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is oké om even te pauzeren als een vraag je overvalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można zrobić pauzę, gdy pytanie cię zaskoczy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är okej att pausa när en fråga överraskar dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru seni hazırlıksız yakaladığında duraksamak normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нормально сделать паузу, когда вопрос застаёт врасплох."
