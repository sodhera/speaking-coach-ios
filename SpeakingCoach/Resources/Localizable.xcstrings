          "stringUnit": {
            "state": "translated",
            "value": "Dat kon nu niet worden gecontroleerd. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz sprawdzić. Spróbuj za chwilę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att kontrollera just nu. Försök igen om en stund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda kontrol edilemedi. Birazdan tekrar dene."
          }
        },
