    "Describe any conversation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe cualquier conversación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris n'importe quelle conversation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe ein beliebiges Gespräch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi qualsiasi conversazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva qualquer conversa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf elk gesprek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz dowolną rozmowę"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv vilket samtal som helst"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir konuşmayı anlat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите любой разговор"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть будь-яку розмову"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी बातचीत बताएँ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف أي محادثة"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな会話でも説明してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 대화든 설명해 보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述任意一段对话"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan percakapan apa saja"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilarawan ang kahit anong usapan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả bất kỳ cuộc trò chuyện nào"
          }
        }
      }
    },
    "Describe any conversation. Your partner plays the other side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe cualquier conversación. Tu compañero hace el otro papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris n'importe quelle conversation. Ton partenaire joue l'autre rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe ein beliebiges Gespräch. Dein Gegenüber übernimmt die andere Seite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi qualsiasi conversazione. Il tuo partner interpreta l'altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva qualquer conversa. Seu parceiro faz o outro lado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf elk gesprek. Je partner speelt de andere kant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz dowolną rozmowę. Twój partner zagra drugą stronę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv vilket samtal som helst. Din partner spelar den andra sidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir konuşmayı anlat. Partnerin karşı tarafı oynar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите любой разговор. Партнёр сыграет другую сторону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишіть будь-яку розмову. Партнер зіграє іншу сторону."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी बातचीत बताएँ। आपका पार्टनर दूसरी तरफ़ का किरदार निभाएगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف أي محادثة. يؤدي شريكك دور الطرف الآخر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな会話でも説明してください。相手役はパートナーが演じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
