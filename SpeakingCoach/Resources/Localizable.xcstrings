            "value": "Ik kijk eerst even rond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw się rozejrzę"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag tittar runt först"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
