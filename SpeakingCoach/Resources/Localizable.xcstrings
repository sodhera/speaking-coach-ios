    "What are you practicing for?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Para qué estás practicando?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour quoi t'entraînes-tu ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür übst du?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cosa ti stai allenando?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que você está praticando?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarvoor oefen je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czego się przygotowujesz?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad övar du inför?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne için pratik yapıyorsun?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К чему вы готовитесь?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До чого ви готуєтеся?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किस चीज़ की तैयारी कर रहे हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
