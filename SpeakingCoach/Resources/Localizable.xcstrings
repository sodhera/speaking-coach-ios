          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقى هادئًا"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いていられる"
          }
        },
        "ko": {
          "stringUnit": {
