    "Ready to walk into your next meeting prepared?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Listo para llegar preparado a tu próxima reunión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à aborder ta prochaine réunion bien préparé ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit, gut vorbereitet in dein nächstes Meeting zu gehen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto ad affrontare la tua prossima riunione preparato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para chegar preparado à sua próxima reunião?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar om goed voorbereid je volgende vergadering in te gaan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idziemy na następne spotkanie przygotowani?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo att gå in i ditt nästa möte förberedd?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki toplantına hazırlıklı girmeye hazır mısın?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовы прийти на следующую встречу подготовленными?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готові прийти на наступну зустріч підготовленими?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी अगली मीटिंग में पूरी तैयारी से जाने के लिए तैयार हैं?"
