    "A colleague wants more. Say no, kindly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compañero te pide más. Di que no, con amabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collègue en demande plus. Dis non, gentiment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kollege will mehr. Sag freundlich Nein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collega vuole di più. Digli di no, con gentilezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um colega quer mais. Diga não, com gentileza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een collega wil meer. Zeg vriendelijk nee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolega chce więcej. Odmów, uprzejmie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kollega vill ha mer. Säg nej, vänligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir iş arkadaşın daha fazlasını istiyor. Nazikçe hayır de."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коллега просит ещё. Откажите — вежливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колега просить ще. Відмовте — ввічливо."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सहकर्मी और माँग रहा है। विनम्रता से मना करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زميل يطلب المزيد. قل لا، بلطف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同僚がさらに頼んできます。やんわり断りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동료가 더 많은 걸 부탁해요. 정중하게 거절해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同事又来找你帮忙。礼貌地拒绝吧。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekan kerja minta lebih. Tolak dengan sopan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May gusto pang ipagawa ang katrabaho. Tumanggi nang maayos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng nghiệp muốn nhờ thêm. Hãy từ chối một cách tử tế."
          }
        }
      }
    },
