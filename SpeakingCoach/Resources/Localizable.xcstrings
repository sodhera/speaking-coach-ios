    "How ready do you feel for that conversation right now?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tan preparado te sientes ahora para esa conversación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point te sens-tu prêt pour cette conversation maintenant ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bereit fühlst du dich gerade für dieses Gespräch?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti senti pronto ora per quella conversazione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão preparado você se sente agora para essa conversa?"
          }
        },
