    "Real conversations, out loud, with a partner who plays the other side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones reales, en voz alta, con un compañero que hace el otro papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De vraies conversations, à voix haute, avec un partenaire qui joue l'autre rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte Gespräche, laut, mit einem Gegenüber, das die andere Seite spielt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversazioni vere, ad alta voce, con un partner che interpreta l'altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas reais, em voz alta, com um parceiro que faz o outro lado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte gesprekken, hardop, met een partner die de andere kant speelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawdziwe rozmowy, na głos, z partnerem, który gra drugą stronę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Riktiga samtal, högt, med en partner som spelar den andra sidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek konuşmalar, sesli olarak, karşı tarafı oynayan bir partnerle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящие разговоры вслух с партнёром, который играет другую сторону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справжні розмови вголос із партнером, який грає іншу сторону."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असली बातचीत, ज़ोर से, एक पार्टनर के साथ जो दूसरी तरफ़ का किरदार निभाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثات حقيقية، بصوت عالٍ، مع شريك يؤدي دور الطرف الآخر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルな会話を声に出して。相手役はパートナーが演じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 대화를 소리 내어. 파트너가 상대 역할을 맡아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大声练习真实对话，搭档扮演对方。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan nyata, dengan suara keras, bersama partner yang memerankan pihak lain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Totoong usapan, nang malakas, kasama ang partner na gaganap sa kabilang panig."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những cuộc trò chuyện thật, thành tiếng, với bạn tập đóng vai bên kia."
          }
        }
      }
    },
