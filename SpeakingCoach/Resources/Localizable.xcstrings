        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 회의에 준비된 모습으로 들어갈 준비가 되셨나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好有备而来地参加下次会议了吗？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap menghadapi rapat berikutnya dengan persiapan matang?"
          }
        },
        "fil": {
