            "value": "%@, bunun üzerinde birlikte çalışacağız."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, мы справимся с этим вместе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ми впораємося з цим разом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, हम इस पर साथ मिलकर काम करेंगे।"
