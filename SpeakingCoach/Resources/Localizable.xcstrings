    "Everyday conversations, out loud, with a partner who plays the other side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones cotidianas, en voz alta, con un compañero que hace el otro papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations du quotidien, à voix haute, avec un partenaire qui joue l'autre rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltagsgespräche, laut, mit einem Gegenüber, das die andere Seite spielt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversazioni quotidiane, ad alta voce, con un partner che interpreta l'altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas do dia a dia, em voz alta, com um parceiro que faz o outro lado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alledaagse gesprekken, hardop, met een partner die de andere kant speelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne rozmowy, na głos, z partnerem, który gra drugą stronę."
          }
        },
        "sv": {
