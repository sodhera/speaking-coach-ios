            "value": "Buổi phỏng vấn diễn ra trong tuần này."
          }
        }
      }
    },
    "Your interview, out loud, with a partner who plays the other side.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entrevista, en voz alta, con un compañero que hace el otro papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton entretien, à voix haute, avec un partenaire qui joue l'autre rôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Vorstellungsgespräch, laut, mit einem Gegenüber, das die andere Seite spielt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo colloquio, ad alta voce, con un partner che interpreta l'altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
