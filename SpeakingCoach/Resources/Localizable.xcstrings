          "stringUnit": {
            "state": "translated",
            "value": "Bir toplantıda katılmıyorsun. Söyle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не согласны на встрече. Скажите это."
