    "Allow Screen Time access first. Speaking Coach never sees which apps you choose.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero permite el acceso a Tiempo de uso. Speaking Coach nunca ve qué apps eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise d'abord l'accès à Temps d'écran. Speaking Coach ne voit jamais quelles apps tu choisis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube zuerst den Zugriff auf die Bildschirmzeit. Speaking Coach sieht nie, welche Apps du auswählst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima consenti l'accesso a Tempo di utilizzo. Speaking Coach non vede mai quali app scegli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, permita o acesso ao Tempo de Uso. O Speaking Coach nunca vê quais apps você escolhe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta eerst toegang tot Schermtijd toe. Speaking Coach ziet nooit welke apps je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zezwól na dostęp do Czasu przed ekranem. Speaking Coach nigdy nie widzi, jakie aplikacje wybierasz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till Skärmtid först. Speaking Coach ser aldrig vilka appar du väljer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Ekran Süresi erişimine izin ver. Speaking Coach hangi uygulamaları seçtiğini asla görmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала разрешите доступ к Экранному времени. Speaking Coach никогда не видит, какие приложения вы выбираете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу дозвольте доступ до Екранного часу. Speaking Coach ніколи не бачить, які програми ви вибираєте."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले स्क्रीन टाइम की अनुमति दें। Speaking Coach कभी नहीं देखता कि आप कौन-से ऐप चुनते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح أولًا بالوصول إلى مدة استخدام الجهاز. لا يرى Speaking Coach أبدًا التطبيقات التي تختارها."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずスクリーンタイムへのアクセスを許可してください。Speaking Coachがあなたの選んだアプリを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 스크린 타임 접근을 허용해 주세요. Speaking Coach는 어떤 앱을 선택했는지 절대 알 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先允许访问屏幕使用时间。Speaking Coach 永远无法看到你选了哪些 App。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Durasi Layar dulu. Speaking Coach tidak pernah melihat app mana yang kamu pilih."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan muna ang access sa Screen Time. Hindi kailanman makikita ng Speaking Coach kung aling apps ang pinili mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
