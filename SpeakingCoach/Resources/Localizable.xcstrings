    "Speaking Coach only listens while you practice. Nothing is recorded outside a session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach solo escucha mientras practicas. No se graba nada fuera de una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach n'écoute que pendant tes séances. Rien n'est enregistré en dehors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach hört nur zu, während du übst. Außerhalb einer Einheit wird nichts aufgenommen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach ascolta solo mentre ti alleni. Fuori da una sessione non viene registrato nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Speaking Coach só escuta enquanto você pratica. Nada é gravado fora de uma sessão."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach luistert alleen terwijl je oefent. Buiten een sessie wordt niets opgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach słucha tylko podczas ćwiczeń. Poza sesją nic nie jest nagrywane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach lyssnar bara medan du övar. Ingenting spelas in utanför en session."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach yalnızca pratik yaparken dinler. Oturum dışında hiçbir şey kaydedilmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach слушает только во время практики. Вне сессии ничего не записывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach слухає лише під час практики. Поза сесією нічого не записується."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach सिर्फ़ अभ्यास के दौरान सुनता है। सेशन के बाहर कुछ भी रिकॉर्ड नहीं होता।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستمع Speaking Coach إلا أثناء تدرّبك. لا يُسجَّل شيء خارج الجلسة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coachが聞くのは練習中だけです。セッション外では何も録音されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach는 연습하는 동안에만 들어요. 세션 밖에서는 아무것도 녹음하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach 只在你练习时聆听。练习之外不会录制任何内容。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach hanya mendengarkan saat kamu berlatih. Tidak ada yang direkam di luar sesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakikinig lang ang Speaking Coach habang nagpa-practice ka. Walang nire-record sa labas ng session."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach chỉ nghe khi bạn luyện tập. Không có gì được ghi âm ngoài buổi tập."
          }
        }
      }
    },
    "Speaking better, day to day": {
