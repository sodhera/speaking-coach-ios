    "Give the talk out loud, moving through them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da la charla en voz alta y ve pasando las diapositivas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais ton discours à voix haute en faisant défiler tes diapos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Vortrag laut und geh dabei deine Folien durch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai il discorso ad alta voce, scorrendo le slide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a fala em voz alta, passando pelos slides."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de presentatie hardop en ga je dia's langs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygłoś wystąpienie na głos, przełączając slajdy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll talet högt och bläddra genom bilderna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaytlarında ilerleyerek konuşmayı sesli yap."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите выступление вслух, листая слайды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть виступ уголос, гортаючи слайди."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइड बदलते हुए ज़ोर से भाषण दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألقِ الحديث بصوت عالٍ وأنت تنتقل بين الشرائح."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドをめくりながら、声に出して話しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드를 넘기며 소리 내어 발표해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边翻幻灯片，边大声讲。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawakan pidatonya dengan suara keras sambil berpindah slide."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibigay ang talk nang malakas habang inililipat ang slides."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình bày thành tiếng, lướt qua từng trang chiếu."
          }
        }
      }
    },
    "Give your view and one reason.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da tu opinión y una razón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne ton avis et une raison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag deine Meinung und einen Grund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai la tua opinione e un motivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê sua opinião e um motivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je mening en één reden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj swoje zdanie i jeden powód."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg vad du tycker och ge ett skäl."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüşünü ve bir nedenini söyle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выскажите мнение и одну причину."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висловте думку й одну причину."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी राय और एक कारण बताएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل رأيك وسببًا واحدًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意見と理由を一つ述べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견과 이유 하나를 말해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出你的观点和一个理由。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampaikan pendapatmu dan satu alasan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibigay ang pananaw mo at isang dahilan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nêu quan điểm và một lý do."
          }
        }
      }
    },
