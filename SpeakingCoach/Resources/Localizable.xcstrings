    "At 9 am. The reminder never shows what it's for.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las 9:00. El recordatorio nunca muestra para qué es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 9 h. Le rappel ne dit jamais à quoi il sert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um 9 Uhr. Die Erinnerung verrät nie, wofür sie ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 9. Il promemoria non dice mai a cosa serve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às 9h. O lembrete nunca mostra do que se trata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om 9:00 uur. De herinnering laat nooit zien waarvoor hij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O 9:00. Przypomnienie nigdy nie pokazuje, czego dotyczy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. 9. Påminnelsen visar aldrig vad den gäller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat 09.00'da. Hatırlatıcı neyle ilgili olduğunu asla göstermez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В 9:00. Напоминание никогда не показывает, о чём оно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "О 9:00. Нагадування ніколи не показує, про що воно."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह 9 बजे। रिमाइंडर कभी नहीं बताता कि वह किस लिए है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة 9 صباحًا. لا يُظهر التذكير أبدًا الغرض منه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午前9時。通知には内容が表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오전 9시. 알림에는 무엇에 관한 것인지 표시되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上午9点。提醒不会显示内容。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul 9 pagi. Pengingat tidak pernah menunjukkan untuk apa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alas-9 ng umaga. Hindi kailanman ipinapakita ng paalala kung para saan ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc 9 giờ sáng. Lời nhắc không bao giờ hiển thị nội dung."
          }
        }
      }
    },
