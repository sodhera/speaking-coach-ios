    "{Sorry, um,} this is probably wrong, but {I think, like,} we're missing the cost side?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{Perdón, eh,} seguramente me equivoco, pero {creo que, o sea,} nos falta la parte de costes?"
