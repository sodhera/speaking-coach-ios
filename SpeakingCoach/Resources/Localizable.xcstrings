    "Your sessions and feedback stay. Only the plan and its reminder go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sesiones y comentarios se quedan. Solo se van el plan y su recordatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes séances et retours restent. Seuls le plan et son rappel disparaissent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einheiten und dein Feedback bleiben. Nur der Plan und seine Erinnerung verschwinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni e i feedback restano. Se ne vanno solo il piano e il suo promemoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas sessões e feedbacks ficam. Só o plano e o lembrete dele vão embora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sessies en feedback blijven. Alleen het plan en de herinnering verdwijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje i informacje zwrotne zostają. Znika tylko plan i jego przypomnienie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sessioner och din återkoppling finns kvar. Bara planen och dess påminnelse försvinner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumların ve geri bildirimlerin kalır. Yalnızca plan ve hatırlatıcısı gider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии и разборы останутся. Удалятся только план и его напоминание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесії й розбори залишаться. Видаляться лише план і його нагадування."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेशन और फ़ीडबैक बने रहेंगे। सिर्फ़ प्लान और उसका रिमाइंडर हटेगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى جلساتك وملاحظاتك. تذهب الخطة وتذكيرها فقط."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションとフィードバックは残ります。削除されるのはプランとそのリマインダーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션과 피드백은 그대로 남아요. 플랜과 알림만 제거돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的练习和反馈会保留。只移除计划及其提醒。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi dan masukanmu tetap ada. Hanya paket dan pengingatnya yang dihapus."
          }
        },
        "fil": {
          "stringUnit": {
