          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть, щоб розблокувати"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक के लिए बोलें"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث لفتح القفل"
