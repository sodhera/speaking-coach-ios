    "Notifications are off for Speaking Coach. Turn them on in Settings for the daily prompt.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Speaking Coach están desactivadas. Actívalas en Ajustes para el reto diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Speaking Coach sont désactivées. Active-les dans Réglages pour le défi du jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Speaking Coach sind aus. Schalte sie für den Tagesimpuls in den Einstellungen ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di Speaking Coach sono disattivate. Attivale in Impostazioni per lo spunto del giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do Speaking Coach estão desativadas. Ative-as em Ajustes para o desafio diário."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen voor Speaking Coach staan uit. Zet ze aan in Instellingen voor de dagelijkse vraag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia Speaking Coach są wyłączone. Włącz je w Ustawieniach, aby dostawać codzienne wyzwanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser för Speaking Coach är avstängda. Slå på dem i Inställningar för dagens fråga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach bildirimleri kapalı. Günlük soru için Ayarlar'dan aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления Speaking Coach выключены. Включите их в Настройках, чтобы получать вопрос дня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення Speaking Coach вимкнено. Увімкніть їх у Параметрах, щоб отримувати питання дня."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach की सूचनाएँ बंद हैं। रोज़ के सवाल के लिए सेटिंग्स में इन्हें चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات Speaking Coach متوقفة. شغّلها في الإعدادات لتصلك أسئلة اليوم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coachの通知がオフです。今日のお題を受け取るには「設定」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach 알림이 꺼져 있어요. 오늘의 질문을 받으려면 설정에서 켜 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking Coach 的通知已关闭。在“设置”中打开即可收到每日话题。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi untuk Speaking Coach mati. Nyalakan di Pengaturan untuk menerima topik harianmu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang notifications para sa Speaking Coach. I-on ito sa Settings para matanggap ang tanong ng araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo của Speaking Coach đang tắt. Bật trong Cài đặt để nhận chủ đề hằng ngày."
          }
        }
      }
    },
