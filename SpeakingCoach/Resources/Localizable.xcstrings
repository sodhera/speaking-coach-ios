    "Create a free account so your plan and progress follow you to any device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta gratuita para que tu plan y tu progreso te sigan a cualquier dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un compte gratuit pour retrouver ton plan et tes progrès sur tous tes appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein kostenloses Konto, damit dein Plan und dein Fortschritt dich auf jedes Gerät begleiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un account gratuito così il tuo piano e i tuoi progressi ti seguono su ogni dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma conta grátis para que seu plano e seu progresso te acompanhem em qualquer aparelho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een gratis account zodat je plan en voortgang met je meegaan naar elk apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załóż darmowe konto, aby twój plan i postępy były dostępne na każdym urządzeniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa ett kostnadsfritt konto så att din plan och dina framsteg följer med till alla enheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planın ve ilerlemen her cihazda seninle olsun diye ücretsiz bir hesap oluştur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте бесплатный аккаунт, чтобы план и прогресс были с вами на любом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть безкоштовний обліковий запис, щоб ваш план і прогрес були з вами на будь-якому пристрої."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त खाता बनाएँ ताकि आपका प्लान और प्रगति हर डिवाइस पर आपके साथ रहे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ حسابًا مجانيًا لترافقك خطتك وتقدمك على أي جهاز."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料アカウントを作成すると、プランと進捗をどのデバイスでも引き継げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 계정을 만들면 플랜과 진행 상황을 어느 기기에서나 이어갈 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建免费账户，你的计划和进度就能在任何设备上同步。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat akun gratis agar paket dan progresmu ikut ke perangkat mana pun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa ng libreng account para masundan ka ng plan at progreso mo sa kahit anong device."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tài khoản miễn phí để kế hoạch và tiến độ theo bạn trên mọi thiết bị."
          }
        }
      }
    },
