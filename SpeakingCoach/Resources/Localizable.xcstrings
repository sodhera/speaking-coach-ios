    "No apology. The ask, then the evidence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin disculpas. La petición y luego las pruebas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'excuses. La demande, puis les preuves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Entschuldigung. Erst die Bitte, dann die Belege."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente scuse. La richiesta, poi i fatti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem pedir desculpas. O pedido, depois as evidências."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen excuses. Eerst het verzoek, dan het bewijs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez przepraszania. Najpierw prośba, potem dowody."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ursäkt. Först frågan, sedan beläggen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özür yok. Önce istek, sonra kanıt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без извинений. Сначала просьба, затем доводы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без вибачень. Спершу прохання, потім аргументи."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई माफ़ी नहीं। पहले माँग, फिर सबूत।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا اعتذار. الطلب أولًا، ثم الدليل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "謝らない。お願いしてから根拠を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사과하지 마세요. 요청 먼저, 근거는 그다음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要道歉。先提要求，再给依据。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa minta maaf. Permintaan dulu, lalu buktinya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang paumanhin. Ang hiling, tapos ang patunay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xin lỗi. Đề nghị trước, bằng chứng sau."
          }
        }
      }
    },
    "No date, I just want to be ready": {
      "localizations": {
