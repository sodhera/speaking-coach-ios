    "PDF works best. From PowerPoint or Keynote: File → Export → PDF.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PDF funciona mejor. Desde PowerPoint o Keynote: Archivo → Exportar → PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PDF fonctionne le mieux. Depuis PowerPoint ou Keynote : Fichier → Exporter → PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF funktioniert am besten. In PowerPoint oder Keynote: Ablage → Exportieren → PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il PDF funziona meglio. Da PowerPoint o Keynote: File → Esporta → PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF funciona melhor. No PowerPoint ou Keynote: Arquivo → Exportar → PDF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pdf werkt het best. In PowerPoint of Keynote: Archief → Exporteer → PDF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepiej działa PDF. W PowerPoincie lub Keynote: Plik → Eksportuj → PDF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF fungerar bäst. Från PowerPoint eller Keynote: Arkiv → Exportera → PDF."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En iyi PDF ile çalışır. PowerPoint ya da Keynote'ta: Dosya → Dışa Aktar → PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше всего подходит PDF. В PowerPoint или Keynote: Файл → Экспорт → PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраще підходить PDF. У PowerPoint або Keynote: Файл → Експорт → PDF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF सबसे अच्छा काम करता है। PowerPoint या Keynote से: फ़ाइल → एक्सपोर्ट → PDF।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل ملف PDF بشكل أفضل. من PowerPoint أو Keynote: ملف ← تصدير ← PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFが最適です。PowerPointやKeynoteから：ファイル → 書き出す → PDF。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF가 가장 좋아요. PowerPoint나 Keynote에서: 파일 → 내보내기 → PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 效果最好。在 PowerPoint 或 Keynote 中：文件 → 导出 → PDF。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF paling cocok. Dari PowerPoint atau Keynote: File → Ekspor → PDF."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinakamainam ang PDF. Mula sa PowerPoint o Keynote: File → Export → PDF."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF là tốt nhất. Từ PowerPoint hoặc Keynote: Tệp → Xuất → PDF."
          }
        }
      }
    },
