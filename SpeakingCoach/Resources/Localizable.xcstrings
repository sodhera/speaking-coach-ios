    "A difficult conversation can stay with you afterward.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación difícil puede quedarse contigo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une conversation difficile peut te rester en tête après."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein schwieriges Gespräch kann einen danach noch beschäftigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversazione difficile può restarti addosso dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa difícil pode ficar na cabeça depois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een moeilijk gesprek kan je daarna nog bezighouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trudna rozmowa może zostać w głowie na długo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svårt samtal kan stanna kvar i dig efteråt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zor bir konuşma sonrasında da akılda kalabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трудный разговор может не отпускать и после."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складна розмова може не відпускати й потім."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुश्किल बातचीत बाद में भी मन में रह सकती है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تبقى المحادثة الصعبة معك بعد انتهائها."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "難しい会話は、あとまで心に残ることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어려운 대화는 끝난 뒤에도 마음에 남을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次艰难的对话，事后可能会一直萦绕在心头。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan sulit bisa terus terbayang setelahnya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mahirap na usapan ay puwedeng bumalik-balik sa isip mo pagkatapos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cuộc trò chuyện khó có thể còn đọng lại trong bạn sau đó."
          }
        }
      }
    },
