    "%@, here's our promise.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, esta es nuestra promesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, voici notre promesse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, das ist unser Versprechen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ecco la nostra promessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, esta é a nossa promessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dit is onze belofte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, oto nasza obietnica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, det här är vårt löfte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, işte sözümüz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, вот наше обещание."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ось наша обіцянка."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, यह रहा हमारा वादा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، هذا وعدنا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、これが私たちの約束です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님, 저희가 약속할게요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，这是我们的承诺。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ini janji kami."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ito ang pangako namin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, đây là lời hứa của chúng tôi."
          }
        }
      },
      "comment": "Slot: the user's first name."
    },
    "%@, ready to meet new people with ease?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ¿listo para conocer gente nueva con soltura?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, prêt à rencontrer de nouvelles personnes avec aisance ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bereit, entspannt neue Leute kennenzulernen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pronto a conoscere persone nuove con disinvoltura?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pronto para conhecer pessoas novas com facilidade?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, klaar om ontspannen nieuwe mensen te ontmoeten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, poznajemy nowych ludzi swobodnie?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, redo att träffa nya människor med lätthet?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, yeni insanlarla rahatça tanışmaya hazır mısın?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, готовы легко знакомиться с новыми людьми?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, готові легко знайомитися з новими людьми?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, नए लोगों से सहजता से मिलने के लिए तैयार हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، هل أنت مستعد للتعرّف على أشخاص جدد بسهولة؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、初めての人と気楽に会う準備はできましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님, 새로운 사람을 편하게 만날 준비가 되셨나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，准备好轻松结识新朋友了吗？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
