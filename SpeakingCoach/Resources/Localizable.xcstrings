          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan tidak selesai. Silakan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang pagbabalik. Pakisubukan ulit."
          }
        },
