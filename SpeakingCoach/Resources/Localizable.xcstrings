            "value": "Партнер не зміг під'єднатися. Спробуйте трохи згодом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पार्टनर कनेक्ट नहीं हो सका। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
