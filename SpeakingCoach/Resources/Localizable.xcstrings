        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu kurz für Feedback. Halte zumindest einen Teil des Vortrags laut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era troppo breve per un feedback. Fai almeno una parte del discorso ad alta voce."
