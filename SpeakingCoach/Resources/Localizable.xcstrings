    "Something broken, confusing, or missing? We read every message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo roto, confuso o que falta? Leemos todos los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose de cassé, de flou ou qui manque ? On lit chaque message."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas kaputt, verwirrend oder fehlt etwas? Wir lesen jede Nachricht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non funziona, non è chiaro o manca? Leggiamo ogni messaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo quebrado, confuso ou faltando? Lemos todas as mensagens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets kapot, verwarrend of mis je iets? We lezen elk bericht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś nie działa, jest niejasne albo czegoś brakuje? Czytamy każdą wiadomość."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något trasigt, förvirrande eller saknas något? Vi läser varje meddelande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk, kafa karıştırıcı ya da eksik bir şey mi var? Her mesajı okuyoruz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то сломалось, непонятно или чего-то не хватает? Мы читаем каждое сообщение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось зламалося, незрозуміло чи чогось бракує? Ми читаємо кожне повідомлення."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ टूटा, उलझा या छूटा हुआ है? हम हर संदेश पढ़ते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل هناك شيء معطّل أو مُربك أو ناقص؟ نقرأ كل رسالة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合、わかりにくい点、足りない機能はありますか？すべてのメッセージを読んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고장 난 곳, 헷갈리는 곳, 빠진 기능이 있나요? 모든 메시지를 읽어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么坏了、让人困惑或缺少的吗？每条消息我们都会看。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang rusak, membingungkan, atau kurang? Kami membaca setiap pesan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May sira, nakakalito, o kulang? Binabasa namin ang bawat mensahe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có gì bị lỗi, khó hiểu hay còn thiếu? Chúng tôi đọc mọi tin nhắn."
          }
        }
      }
    },
    "Something coming up?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Se acerca algo?"
          }
        },
        "fr": {
