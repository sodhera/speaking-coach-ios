    "We couldn't hear an answer. Try again a little closer to the phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No oímos una respuesta. Inténtalo de nuevo un poco más cerca del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On n'a pas entendu de réponse. Réessaie un peu plus près du téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten keine Antwort hören. Versuch es etwas näher am Telefon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo sentito una risposta. Riprova un po' più vicino al telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ouvimos uma resposta. Tente de novo um pouco mais perto do celular."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hoorden geen antwoord. Probeer het opnieuw, iets dichter bij de telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usłyszeliśmy odpowiedzi. Spróbuj ponownie trochę bliżej telefonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hörde inget svar. Försök igen lite närmare telefonen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yanıt duyamadık. Telefona biraz daha yakın tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не услышали ответ. Попробуйте ещё раз ближе к телефону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми не почули відповіді. Спробуйте ще раз ближче до телефона."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें कोई जवाब नहीं सुनाई दिया। फ़ोन के थोड़ा पास आकर फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نسمع إجابة. حاول مجددًا وأنت أقرب قليلًا إلى الهاتف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が聞こえませんでした。もう少し端末に近づいて、もう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 들리지 않았어요. 기기에 조금 더 가까이 대고 다시 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没听到回答。请离设备近一点再试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak mendengar jawaban. Coba lagi sedikit lebih dekat ke perangkat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala kaming narinig na sagot. Subukan ulit nang mas malapit nang kaunti sa device."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không nghe thấy câu trả lời. Thử lại gần thiết bị hơn một chút."
          }
        }
      }
    },
    "We couldn't hear any speech in that recording. Check the microphone isn't covered and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No oímos voz en esa grabación. Comprueba que el micrófono no esté tapado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On n'a entendu aucune voix dans cet enregistrement. Vérifie que le micro n'est pas couvert et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Aufnahme war keine Sprache zu hören. Prüfe, ob das Mikrofon verdeckt ist, und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo sentito voci in quella registrazione. Controlla che il microfono non sia coperto e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não ouvimos fala nessa gravação. Verifique se o microfone não está coberto e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hoorden geen spraak in die opname. Controleer of de microfoon niet bedekt is en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym nagraniu nie było słychać mowy. Sprawdź, czy mikrofon nie jest zasłonięty, i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hörde inget tal i inspelningen. Kontrollera att mikrofonen inte är täckt och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O kayıtta konuşma duyamadık. Mikrofonun kapalı olmadığını kontrol et ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В записи не слышно речи. Проверьте, не закрыт ли микрофон, и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У записі не чути мовлення. Перевірте, чи не закритий мікрофон, і спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस रिकॉर्डिंग में कोई आवाज़ नहीं सुनाई दी। जाँचें कि माइक्रोफ़ोन ढका न हो और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نسمع كلامًا في ذلك التسجيل. تأكد أن الميكروفون غير مغطى وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その録音では声が聞こえませんでした。マイクがふさがれていないか確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음에서 말소리가 들리지 않았어요. 마이크가 가려져 있지 않은지 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那段录音里没听到说话声。请检查麦克风是否被遮挡，然后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak mendengar suara apa pun di rekaman itu. Pastikan mikrofon tidak tertutup, lalu coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala kaming narinig na pagsasalita sa recording na iyon. Tingnan kung may nakatakip sa mikropono, tapos subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không nghe thấy tiếng nói trong bản ghi đó. Kiểm tra micrô có bị che không, rồi thử lại."
          }
        }
      }
    },
    "We couldn't verify your sign-in. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
