      }
    },
    "Your partner couldn't connect. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compañero no pudo conectarse. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton partenaire n'a pas pu se connecter. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gegenüber konnte sich nicht verbinden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo partner non è riuscito a connettersi. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu parceiro não conseguiu se conectar. Verifique sua conexão e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je partner kon niet verbinden. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner nie mógł się połączyć. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din partner kunde inte ansluta. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnerin bağlanamadı. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёр не смог подключиться. Проверьте подключение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнер не зміг під'єднатися. Перевірте з'єднання й спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पार्टनर कनेक्ट नहीं हो सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر اتصال شريكك. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 연결되지 않았어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭档无法连接。请检查网络连接后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnermu tidak bisa terhubung. Periksa koneksimu dan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makakonekta ang partner mo. Tingnan ang koneksyon mo at subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tập không thể kết nối. Kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
    "Your partner couldn't connect. Try again in a moment.": {
