    "Lower than when you started. That's worth another session before the day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más bajo que al principio. Merece otra sesión antes del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bas qu'au départ. Ça vaut une autre séance avant le jour J."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger als zu Beginn. Das ist eine weitere Einheit vor dem großen Tag wert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più basso rispetto all'inizio. Vale un'altra sessione prima del giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais baixo do que no início. Vale mais uma sessão antes do dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager dan toen je begon. Dat is nog een sessie waard voor de dag zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niżej niż na początku. Warto zrobić jeszcze jedną sesję przed tym dniem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägre än när du började. Det är värt en session till före dagen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başladığından daha düşük. O günden önce bir oturum daha yapmaya değer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже, чем в начале. Стоит провести ещё одну сессию до того дня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче, ніж на початку. Варто провести ще одну сесію до того дня."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत से कम। उस दिन से पहले एक और सेशन करना ठीक रहेगा।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل مما بدأت به. تستحق جلسة أخرى قبل ذلك اليوم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初より下がっています。本番までにもう一度セッションを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음보다 낮아졌어요. 그날 전에 세션을 한 번 더 해 볼 만해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比开始时低。在那天之前值得再练一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih rendah dari saat kamu mulai. Layak satu sesi lagi sebelum hari-H."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mababa kaysa noong nagsimula ka. Sulit ang isa pang session bago ang araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thấp hơn lúc bạn bắt đầu. Đáng để tập thêm một buổi trước ngày đó."
          }
        }
      }
    },
