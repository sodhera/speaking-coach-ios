    "Pick the one that matters most.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige lo que más te importe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce qui compte le plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl, was dir am wichtigsten ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quella che conta di più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que mais importa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat het belangrijkst is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz to, co najważniejsze."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det som betyder mest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En önemli olanı seç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите самое важное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть найважливіше."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो सबसे ज़रूरी है, वह चुनें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأهم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番大切なものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 중요한 것 하나를 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选出最重要的那一项。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih yang paling penting."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang pinakamahalaga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn điều quan trọng nhất."
          }
        }
      }
    },
    "Picture it going well. What's different?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagina que sale bien. ¿Qué es diferente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que ça se passe bien. Qu'est-ce qui change ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, es läuft gut. Was ist anders?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina che vada bene. Cosa cambia?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que deu certo. O que muda?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor dat het goed gaat. Wat is er anders?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyobraź sobie, że idzie dobrze. Co jest inaczej?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreställ dig att det går bra. Vad är annorlunda?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi geçtiğini hayal et. Ne farklı?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, что всё прошло хорошо. Что изменилось?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уявіть, що все пройшло добре. Що змінилося?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोचिए कि यह अच्छा गया। क्या अलग है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخيّل أن الأمر سار بشكل جيد. ما الذي تغيّر؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいった場面を想像してください。何が違いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 풀리는 모습을 떠올려 보세요. 무엇이 다른가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象一切顺利。有什么不同？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayangkan semuanya berjalan lancar. Apa yang berbeda?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isipin na maayos ang takbo. Ano ang naiiba?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình dung mọi việc diễn ra tốt đẹp. Điều gì khác đi?"
          }
        }
      }
    },
    "Picture that conversation going well. What's different?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagina que esa conversación sale bien. ¿Qué es diferente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine que cette conversation se passe bien. Qu'est-ce qui change ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, dieses Gespräch läuft gut. Was ist anders?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina che quella conversazione vada bene. Cosa cambia?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine essa conversa dando certo. O que muda?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor dat dat gesprek goed gaat. Wat is er anders?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyobraź sobie, że ta rozmowa idzie dobrze. Co jest inaczej?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreställ dig att det samtalet går bra. Vad är annorlunda?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O konuşmanın iyi geçtiğini hayal et. Ne farklı?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, что этот разговор прошёл хорошо. Что изменилось?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уявіть, що ця розмова пройшла добре. Що змінилося?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोचिए कि वह बातचीत अच्छी गई। क्या अलग है?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخيّل أن تلك المحادثة سارت بشكل جيد. ما الذي تغيّر؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その話し合いがうまくいった場面を想像してください。何が違いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 대화가 잘 풀리는 모습을 떠올려 보세요. 무엇이 다른가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象那场对话进展顺利。有什么不同？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayangkan percakapan itu berjalan lancar. Apa yang berbeda?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isipin na maayos ang takbo ng usapang iyon. Ano ang naiiba?"
          }
        },
        "vi": {
