    "Open strong and keep the room with you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza fuerte y mantén a la sala contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence fort et garde la salle avec toi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte stark und nimm den Raum mit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti forte e tieni la sala con te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece forte e mantenha a sala com você."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin sterk en houd de zaal bij je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij mocno i utrzymaj uwagę sali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja starkt och håll rummet med dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güçlü başla ve salonu yanında tut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните сильно и удерживайте внимание зала."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть сильно й утримуйте увагу залу."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दमदार शुरुआत करें और श्रोताओं को साथ रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بقوة وأبقِ القاعة معك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力強く始めて、聞き手を引きつけ続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강하게 시작하고 청중을 끝까지 붙잡으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开场有力，并让全场始终跟着你。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dengan kuat dan jaga perhatian ruangan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula nang malakas at hawakan ang atensyon ng kuwarto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở đầu mạnh mẽ và giữ chân cả khán phòng."
          }
        }
      }
    },
    "Open with the most interesting thing you know.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con lo más interesante que sabes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par la chose la plus intéressante que tu saches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit dem Interessantesten, das du weißt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri con la cosa più interessante che sai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com a coisa mais interessante que você sabe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open met het interessantste wat je weet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od najciekawszej rzeczy, jaką wiesz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna med det mest intressanta du vet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiğin en ilginç şeyle aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с самого интересного, что вы знаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із найцікавішого, що знаєте."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे दिलचस्प बात से शुरुआत करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بأكثر شيء مثير تعرفه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが知っている一番面白いことから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 있는 가장 흥미로운 것으로 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你知道的最有趣的事开场。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dengan hal paling menarik yang kamu tahu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula sa pinakakawili-wiling bagay na alam mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở đầu bằng điều thú vị nhất bạn biết."
          }
        }
      }
    },
