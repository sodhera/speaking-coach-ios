          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "청중"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现场"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruangannya"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
