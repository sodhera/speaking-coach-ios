    "The purchase went through, but access didn't unlock. Try Restore.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra se realizó, pero el acceso no se desbloqueó. Prueba Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat a abouti, mais l'accès ne s'est pas débloqué. Essaie Restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf ist durchgegangen, aber der Zugang wurde nicht freigeschaltet. Versuch es mit Wiederherstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è andato a buon fine, ma l'accesso non si è sbloccato. Prova Ripristina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra foi concluída, mas o acesso não foi liberado. Tente Restaurar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop is gelukt, maar de toegang is niet vrijgegeven. Probeer Herstel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup się udał, ale dostęp nie został odblokowany. Spróbuj Odtwórz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick igenom, men åtkomsten låstes inte upp. Prova Återställ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma gerçekleşti ama erişim açılmadı. Geri Yükle'yi dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка прошла, но доступ не открылся. Попробуйте «Восстановить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка пройшла, але доступ не відкрився. Спробуйте «Відновити»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदारी हो गई, लेकिन एक्सेस अनलॉक नहीं हुआ। बहाल करें आज़माएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت عملية الشراء، لكن لم يُفتح الوصول. جرّب «استعادة»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、アクセスが有効になりませんでした。「復元」をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 완료되었지만 이용 권한이 열리지 않았어요. 복원을 시도해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买已完成，但权限未解锁。请尝试“恢复”。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian berhasil, tapi akses belum terbuka. Coba Pulihkan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Natuloy ang pagbili, pero hindi na-unlock ang access. Subukan ang Ibalik."
