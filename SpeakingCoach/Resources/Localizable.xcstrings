    "What you said is saved. Get feedback on it, or let it go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que dijiste está guardado. Recibe comentarios o déjalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu as dit est enregistré. Reçois un retour, ou laisse tomber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gesagt hast, ist gespeichert. Hol dir Feedback dazu oder lass es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai detto è salvato. Ricevi un feedback o lascia stare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você disse está salvo. Receba feedback ou deixe pra lá."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je zei is bewaard. Vraag er feedback op, of laat het gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co powiedziano, jest zapisane. Uzyskaj informację zwrotną albo odpuść."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du sa är sparat. Få återkoppling på det, eller släpp det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediklerin kaydedildi. Geri bildirim al ya da boş ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сказанное сохранено. Получите разбор или оставьте как есть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сказане збережено. Отримайте розбір або залиште як є."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कहा वह सहेजा गया है। इस पर फ़ीडबैक लें, या रहने दें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما قلته محفوظ. احصل على ملاحظات عليه، أو دعه."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容は保存されています。フィードバックを受けるか、やめておくか選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말씀하신 내용은 저장되어 있어요. 피드백을 받거나 그냥 넘길 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的话已保存。可以获取反馈，也可以就此放下。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kamu ucapkan sudah tersimpan. Dapatkan masukan, atau lupakan saja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save ang sinabi mo. Kumuha ng feedback, o hayaan na."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn nói đã được lưu. Nhận nhận xét, hoặc bỏ qua."
          }
        }
      }
    },
    "What you want to say matters.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que quieres decir importa."
          }
