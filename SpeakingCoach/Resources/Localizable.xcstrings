    "Your last session couldn't be opened. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir tu última sesión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dernière séance n'a pas pu s'ouvrir. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzte Einheit konnte nicht geöffnet werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la tua ultima sessione. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir sua última sessão. Verifique sua conexão e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste sessie kon niet worden geopend. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć ostatniej sesji. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din senaste session kunde inte öppnas. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son oturumun açılamadı. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть последнюю сессию. Проверьте подключение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити останню сесію. Перевірте з'єднання й спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पिछला सेशन नहीं खुल सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح جلستك الأخيرة. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションを開けませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 세션을 열 수 없었어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开你上次的练习。请检查网络连接后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi terakhirmu tidak bisa dibuka. Periksa koneksimu dan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabuksan ang huling session mo. Tingnan ang koneksyon mo at subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở buổi tập trước. Kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
