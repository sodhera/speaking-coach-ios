        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài thuyết trình đó có hơn 100 trang chiếu. Hãy thử bản ngắn hơn."
          }
        }
      }
    },
    "That session couldn't be opened. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esa sesión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir cette séance. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einheit konnte nicht geöffnet werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
