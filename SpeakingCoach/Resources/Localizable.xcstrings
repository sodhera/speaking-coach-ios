    "e.g. I need my deposit back, and they keep avoiding the subject.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., necesito que me devuelva la fianza y siempre evita el tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex. j'ai besoin de récupérer ma caution, et il évite toujours le sujet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Ich will meine Kaution zurück, und er weicht dem Thema immer aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es. rivoglio la caparra, e lui evita sempre l'argomento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: preciso do meu depósito de volta, e ele sempre foge do assunto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. ik wil mijn borg terug, en hij ontwijkt het onderwerp steeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. potrzebuję zwrotu kaucji, a on ciągle unika tematu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. jag vill ha tillbaka depositionen, och hen undviker alltid ämnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. depozitomu geri istiyorum ve hep konuyu geçiştiriyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "например, мне нужно вернуть залог, а он всё время уходит от темы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "наприклад, мені потрібно повернути заставу, а він весь час уникає теми."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे, मुझे अपनी सिक्योरिटी डिपॉज़िट वापस चाहिए, और वे हमेशा बात टाल देते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا: أريد استرداد التأمين، ويتهرّب دائمًا من الموضوع."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：敷金を返してほしいのに、いつも話をそらされる。"
          }
        },
        "ko": {
