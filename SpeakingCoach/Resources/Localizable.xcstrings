    "Start with what you want: “I'd like to talk about…”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con lo que quieres: «Me gustaría hablar de…»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par ce que tu veux : « J'aimerais parler de… »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit dem, was du willst: „Ich würde gern über … sprechen“"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti da ciò che vuoi: «Vorrei parlare di…»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com o que você quer: “Gostaria de falar sobre…”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met wat je wilt: 'Ik wil het graag hebben over…'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od tego, czego chcesz: „Chciałbym porozmawiać o…”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med det du vill: ”Jag skulle vilja prata om …”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğinle başla: \"Şu konuyu konuşmak istiyorum…\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с того, чего хотите: «Я бы хотел обсудить…»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть із того, чого хочете: «Я б хотів обговорити…»"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चाहते हैं उससे शुरू करें: “मैं … के बारे में बात करना चाहता हूँ”"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بما تريده: «أودّ أن نتحدث عن…»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "望むことから始めましょう：「…についてお話ししたいのですが」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 것부터 말하세요: “…에 대해 이야기하고 싶어요.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先说出你想要的：“我想谈谈……”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah dengan apa yang kamu mau: “Saya ingin membicarakan…”"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsimula sa gusto mo: “Gusto kong pag-usapan ang…”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng điều bạn muốn: “Tôi muốn trao đổi về…”"
          }
        }
      }
    },
