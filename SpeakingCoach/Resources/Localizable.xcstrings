            "value": "%@, ci lavoreremo insieme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vamos trabalhar nisso juntos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, we gaan hier samen mee aan de slag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, przejdziemy przez to razem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vi tar oss igenom det här tillsammans."
          }
        },
        "tr": {
          "stringUnit": {
