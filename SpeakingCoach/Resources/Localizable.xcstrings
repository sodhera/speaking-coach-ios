    "Ask for the floor. No disclaimers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide la palabra. Sin disculpas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande la parole. Sans précautions inutiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir das Wort. Ohne Entschuldigungen vorweg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi la parola. Niente premesse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça a palavra. Sem ressalvas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag het woord. Zonder voorbehoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś o głos. Bez zastrzeżeń."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om ordet. Inga förbehåll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söz iste. Özür dileyerek başlama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите слово. Без оговорок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросіть слово. Без застережень."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलने का मौका माँगें। बिना झिझक।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب الكلمة. بلا مقدمات اعتذارية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発言の機会を求めましょう。前置きの言い訳はなしで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발언 기회를 요청하세요. 변명 없이."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动争取发言。不要先找借口。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta giliran bicara. Tanpa basa-basi minta maaf."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humingi ng pagkakataong magsalita. Walang paunang paumanhin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin lượt phát biểu. Không rào đón."
          }
        }
      }
    },
    "Ask for what you want and stay steady under pushback.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide lo que quieres y mantente firme ante las objeciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande ce que tu veux et reste ferme face aux objections."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag, was du willst, und bleib bei Gegenwind standhaft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi ciò che vuoi e resta saldo davanti alle obiezioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça o que você quer e mantenha a firmeza diante das objeções."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag wat je wilt en blijf staan bij tegenwerpingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proś o to, czego chcesz, i trzymaj się mimo sprzeciwu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om det du vill ha och stå kvar när det blir mothugg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğini iste ve itirazlar karşısında yerinde dur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просите то, что хотите, и держитесь, когда возражают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просіть те, чого хочете, і тримайтеся, коли заперечують."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चाहिए वह माँगें और विरोध होने पर टिके रहें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب ما تريد واثبت أمام الاعتراض."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "望むことを伝え、反論されても踏みとどまりましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 것을 요청하고, 반박에도 흔들리지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出你想要的，面对反驳也要稳住。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta apa yang kamu mau dan tetap tenang saat dibantah."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingin ang gusto mo at manatiling matatag kahit may tumutol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề nghị điều bạn muốn và giữ vững khi bị phản bác."
          }
        }
      }
    },
