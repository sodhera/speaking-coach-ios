          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले मैं इधर-उधर देखूँगा"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأتجول أولًا"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは見てみる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 둘러볼게요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我先随便看看"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya lihat-lihat dulu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Titingin-tingin muna ako"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi xem thử trước đã"
          }
        }
      }
    },
    "I'm a designer who turns messy problems into simple tools. Lately, a booking app for local clinics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy diseñadora y convierto problemas enredados en herramientas simples. Lo último, una app de citas para clínicas locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis designer et je transforme des problèmes compliqués en outils simples. Dernièrement, une app de prise de rendez-vous pour des cliniques locales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin Designerin und mache aus chaotischen Problemen einfache Tools. Zuletzt eine Buchungs-App für Arztpraxen vor Ort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono una designer e trasformo problemi complicati in strumenti semplici. Di recente, un'app di prenotazione per ambulatori locali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sou designer e transformo problemas bagunçados em ferramentas simples. A mais recente, um app de agendamento para clínicas locais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben ontwerper en maak van rommelige problemen eenvoudige tools. Laatst een boekingsapp voor lokale praktijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jestem projektantką i zamieniam zagmatwane problemy w proste narzędzia. Ostatnio aplikację do rezerwacji dla lokalnych przychodni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag är designer och gör röriga problem till enkla verktyg. Senast en bokningsapp för lokala vårdcentraler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmaşık sorunları basit araçlara dönüştüren bir tasarımcıyım. En son yerel klinikler için bir randevu uygulaması."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я дизайнер и превращаю запутанные задачи в простые инструменты. Из последнего — приложение для записи в местные клиники."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я дизайнерка й перетворюю заплутані задачі на прості інструменти. З останнього — застосунок для запису в місцеві клініки."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं एक डिज़ाइनर हूँ जो उलझी समस्याओं को आसान टूल में बदलती हूँ। हाल ही में, स्थानीय क्लिनिकों के लिए एक बुकिंग ऐप।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا مصممة أحوّل المشكلات المعقدة إلى أدوات بسيطة. مؤخرًا، تطبيق حجوزات للعيادات المحلية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ごちゃごちゃした課題をシンプルなツールにするデザイナーです。最近は地域のクリニック向けの予約アプリを作りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 문제를 간단한 도구로 바꾸는 디자이너예요. 최근에는 지역 병원을 위한 예약 앱을 만들었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我是一名设计师，把复杂的问题变成简单的工具。最近，我为本地诊所做了一个预约应用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya desainer yang mengubah masalah rumit jadi alat sederhana. Baru-baru ini, aplikasi pemesanan untuk klinik lokal."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Designer ako na ginagawang simpleng tools ang magugulong problema. Kamakailan, isang booking app para sa lokal na klinika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi là nhà thiết kế, biến những vấn đề rối rắm thành công cụ đơn giản. Gần đây là ứng dụng đặt lịch cho phòng khám địa phương."
          }
        }
      }
    },
