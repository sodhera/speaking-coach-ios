    },
    "That was too short to coach. Give at least part of the talk out loud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fue demasiado corto para darte comentarios. Da al menos parte de la charla en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était trop court pour un retour. Fais au moins une partie du discours à voix haute."
          }
