            "value": "예고 없는 질문 하나"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个问题，毫无预告"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pertanyaan, tanpa peringatan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang tanong, walang babala"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu hỏi, không báo trước"
          }
        }
      }
    },
    "One quiet nudge at %@. You can turn it off anytime in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso suave a las %@. Puedes desactivarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel discret à %@. Tu peux le désactiver à tout moment dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Hinweis um %@. Du kannst ihn jederzeit in den Einstellungen ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto alle %@. Puoi disattivarlo quando vuoi in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete discreto às %@. Você pode desativá-lo quando quiser em Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rustige herinnering om %@. Je kunt hem altijd uitzetten in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno ciche przypomnienie o %@. Możesz je wyłączyć w Ustawieniach w każdej chwili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En diskret påminnelse kl. %@. Du kan stänga av den när som helst i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %@'da sessiz bir hatırlatma. İstediğin zaman Ayarlar'dan kapatabilirsin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно тихое напоминание в %@. Его можно выключить в Настройках в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне тихе нагадування о %@. Його можна вимкнути в Параметрах будь-коли."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर एक हल्का-सा रिमाइंडर। आप इसे कभी भी सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه هادئ واحد عند %@. يمكنك إيقافه في أي وقت من الإعدادات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にそっと通知します。「設定」でいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 조용히 한 번 알려드려요. 설정에서 언제든지 끌 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@轻轻提醒一次。你可以随时在“设置”中关闭。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pengingat halus pukul %@. Kamu bisa mematikannya kapan saja di Pengaturan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang tahimik na paalala sa %@. Puwede mo itong i-off kahit kailan sa Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lời nhắc nhẹ lúc %@. Bạn có thể tắt bất cứ lúc nào trong Cài đặt."
          }
        }
      }
    },
    "One sentence, out loud. Thirty seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase, en voz alta. Treinta segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase, à voix haute. Trente secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Satz, laut. Dreißig Sekunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase, ad alta voce. Trenta secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase, em voz alta. Trinta segundos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén zin, hardop. Dertig seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno zdanie, na głos. Trzydzieści sekund."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mening, högt. Trettio sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek cümle, sesli. Otuz saniye."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна фраза вслух. Тридцать секунд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна фраза вголос. Тридцять секунд."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वाक्य, ज़ोर से। तीस सेकंड।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جملة واحدة بصوت عالٍ. ثلاثون ثانية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一文を声に出して。30秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 문장, 소리 내어. 30초."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一句话，大声说。三十秒。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kalimat, dengan suara keras. Tiga puluh detik."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang pangungusap, nang malakas. Tatlumpung segundo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu, thành tiếng. Ba mươi giây."
          }
        }
      }
    },
    "One session compared with one retry. A direction, not proof of lasting change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión comparada con un reintento. Una dirección, no la prueba de un cambio duradero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séance comparée à un nouvel essai. Une tendance, pas la preuve d'un changement durable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einheit im Vergleich mit einer Wiederholung. Eine Richtung, kein Beweis für eine dauerhafte Veränderung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione confrontata con un nuovo tentativo. Una direzione, non la prova di un cambiamento duraturo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão comparada com uma nova tentativa. Uma direção, não prova de uma mudança duradoura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén sessie vergeleken met één herkansing. Een richting, geen bewijs van blijvende verandering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna sesja porównana z jedną powtórką. Kierunek, a nie dowód trwałej zmiany."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En session jämförd med ett nytt försök. En riktning, inte bevis på bestående förändring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oturumun bir tekrarla karşılaştırması. Kalıcı bir değişimin kanıtı değil, bir yön."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сессия в сравнении с одним повтором. Направление, а не доказательство устойчивых перемен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сесія порівняно з одним повтором. Напрям, а не доказ сталих змін."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेशन की तुलना एक दोहराव से। एक दिशा, स्थायी बदलाव का सबूत नहीं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة واحدة مقارنة بإعادة واحدة. اتجاه، لا دليل على تغيير دائم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のセッションと1回のやり直しの比較です。方向性であり、変化が続く証明ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 세션과 한 번의 재시도를 비교한 거예요. 방향을 보여 줄 뿐, 지속적인 변화의 증거는 아니에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次练习与一次重试的对比。只能说明方向，不能证明改变会持续。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu sesi dibandingkan dengan satu kali ulang. Sebuah arah, bukan bukti perubahan yang bertahan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang session kumpara sa isang pag-ulit. Isang direksyon, hindi patunay ng pangmatagalang pagbabago."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một buổi so với một lần thử lại. Là một hướng đi, không phải bằng chứng cho thay đổi lâu dài."
          }
        }
      }
    },
    "One session now makes it easier to walk in ready.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión ahora hace más fácil llegar preparado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séance maintenant, et c'est plus facile d'y aller prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einheit jetzt macht es leichter, vorbereitet hineinzugehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione ora rende più facile arrivare pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão agora facilita chegar preparado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén sessie nu maakt het makkelijker om voorbereid binnen te stappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna sesja teraz ułatwi przyjście przygotowanym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En session nu gör det lättare att gå in förberedd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi bir oturum, hazırlıklı girmeyi kolaylaştırır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сессия сейчас поможет прийти подготовленным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сесія зараз допоможе прийти підготовленими."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी एक सेशन, तैयारी से जाना आसान बना देता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة واحدة الآن تجعل دخولك متهيئًا أسهل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今セッションをしておくと、準備万端で臨みやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 세션 한 번이면 준비된 채로 들어가기가 더 쉬워요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在练一次，更容易有备而来。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu sesi sekarang membuatmu lebih mudah datang dengan siap."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas madaling pumasok nang handa kung magse-session ka ngayon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một buổi tập bây giờ giúp bạn dễ bước vào với sự sẵn sàng hơn."
          }
        }
      }
    },
