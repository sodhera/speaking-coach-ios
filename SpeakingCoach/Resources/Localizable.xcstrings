            "value": "Sua entrevista, em voz alta, com um parceiro que faz o outro lado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sollicitatiegesprek, hardop, met een partner die de andere kant speelt."
