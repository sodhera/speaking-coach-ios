    "Most people never say it out loud until the moment it counts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría nunca lo dice en voz alta hasta el momento en que importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens ne le disent jamais à voix haute avant le moment qui compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten sagen es nie laut, bis der entscheidende Moment kommt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi nessuno lo dice ad alta voce prima del momento che conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria das pessoas nunca diz em voz alta até o momento que importa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste mensen zeggen het nooit hardop tot het moment dat het ertoe doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość ludzi nigdy nie mówi tego na głos aż do decydującej chwili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta säger det aldrig högt förrän det gäller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu insan önemli an gelene kadar bunu asla sesli söylemez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство людей никогда не произносят это вслух до решающего момента."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більшість людей ніколи не кажуть це вголос до вирішального моменту."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादातर लोग अहम पल आने तक इसे कभी ज़ोर से नहीं कहते।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معظم الناس لا يقولونها بصوت عالٍ أبدًا حتى تأتي اللحظة الحاسمة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの人は、本番の瞬間まで一度も声に出しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 사람은 중요한 순간이 오기 전까지 한 번도 소리 내어 말해 보지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数人直到关键时刻才第一次把话说出口。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakan orang tidak pernah mengucapkannya dengan suara keras sampai momen yang menentukan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamihan ay hindi ito sinasabi nang malakas hanggang sa mismong mahalagang sandali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết mọi người chưa bao giờ nói thành tiếng cho đến khoảnh khắc quan trọng."
          }
        }
      }
    },
    "My mind goes blank when I'm put on the spot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me quedo en blanco cuando me ponen en un aprieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai un trou quand on me met sur la sellette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe einen Blackout, wenn ich unvorbereitet gefragt werde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vado nel pallone quando mi mettono sotto pressione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um branco quando sou pego de surpresa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik klap dicht als ik onverwacht iets moet zeggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam pustkę w głowie, gdy ktoś mnie zaskoczy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det blir tomt i huvudet när jag sätts på plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden soru sorulunca aklım duruyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда меня застают врасплох, в голове пусто."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли мене застають зненацька, в голові порожньо."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अचानक पूछे जाने पर मेरा दिमाग खाली हो जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيب ذهني حين أُفاجأ بسؤال."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急に振られると頭が真っ白になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갑자기 질문받으면 머릿속이 하얘져요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被突然点名时，我脑子一片空白。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikiran saya kosong saat ditanya mendadak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nablangko ang isip ko kapag biglang tinanong."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu tôi trống rỗng khi bị hỏi bất ngờ."
          }
        }
      }
    },
    "Name the moment, not the person.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra el momento, no a la persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
