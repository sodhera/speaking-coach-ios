    "Something went wrong. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessaie."
          }
        },
