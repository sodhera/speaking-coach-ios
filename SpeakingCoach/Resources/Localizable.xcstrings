    "Feedback couldn't finish. Your words are saved; please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios no se pudieron completar. Tus palabras están guardadas; inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour n'a pas pu aboutir. Tes mots sont enregistrés ; réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Feedback konnte nicht abgeschlossen werden. Deine Worte sind gespeichert; bitte versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback non è stato completato. Le tue parole sono salvate; riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feedback não pôde ser concluído. Suas palavras estão salvas; tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De feedback kon niet worden afgerond. Je woorden zijn bewaard; probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć informacji zwrotnej. Twoje słowa są zapisane; spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återkopplingen kunde inte slutföras. Dina ord är sparade; försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim tamamlanamadı. Söylediklerin kaydedildi; lütfen tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить разбор. Ваши слова сохранены; попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити розбір. Ваші слова збережено; спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीडबैक पूरा नहीं हो सका। आपके शब्द सहेजे गए हैं; कृपया दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال الملاحظات. كلماتك محفوظة؛ يُرجى المحاولة مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを完了できませんでした。あなたの言葉は保存されています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 완료하지 못했어요. 말씀하신 내용은 저장되어 있으니 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈未能完成。你说的话已保存，请重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan tidak bisa diselesaikan. Kata-katamu tersimpan; silakan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang feedback. Naka-save ang mga sinabi mo; pakisubukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể hoàn tất nhận xét. Lời bạn nói đã được lưu; vui lòng thử lại."
          }
        }
      }
    },
