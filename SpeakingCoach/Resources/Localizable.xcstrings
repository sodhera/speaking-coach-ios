    "{Yeah, um,} sorry to bother you, I know budgets are tight, {but, like,} maybe my pay could {sort of} go up?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{Sí, eh,} perdona que te moleste, sé que el presupuesto está justo, {pero, o sea,} ¿quizá mi sueldo podría {como} subir?"
