    "How at ease do you feel meeting someone new?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tan cómodo te sientes al conocer a alguien nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point te sens-tu à l'aise pour rencontrer quelqu'un de nouveau ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wohl fühlst du dich, wenn du jemand Neues kennenlernst?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti senti a tuo agio nel conoscere qualcuno di nuovo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão à vontade você se sente ao conhecer alguém novo?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe op je gemak voel je je bij het ontmoeten van iemand nieuw?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak swobodnie czujesz się, poznając kogoś nowego?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur bekväm känner du dig när du träffar någon ny?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni biriyle tanışırken ne kadar rahat hissediyorsun?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько вам легко знакомиться с новыми людьми?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки вам легко знайомитися з новими людьми?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नए व्यक्ति से मिलते समय आप कितना सहज महसूस करते हैं?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما مدى ارتياحك عند التعرّف على شخص جديد؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初対面の人と会うとき、どれくらい気楽ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 보는 사람을 만날 때 얼마나 편한가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识新朋友时，你感觉有多自在？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa santai kamu saat bertemu orang baru?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaano ka kapanatag kapag may nakikilalang bagong tao?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thấy thoải mái đến mức nào khi gặp người mới?"
          }
        }
      }
    },
