    "Your opening, out loud, until it lands.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apertura, en voz alta, hasta que funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton ouverture, à voix haute, jusqu'à ce qu'elle porte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Einstieg, laut, bis er sitzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua apertura, ad alta voce, finché non funziona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua abertura, em voz alta, até funcionar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opening, hardop, tot hij landt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje otwarcie, na głos, aż zadziała."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din inledning, högt, tills den sitter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışın, sesli olarak, yerine oturana kadar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше вступление вслух, пока оно не сработает."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вступ уголос, доки він не спрацює."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी शुरुआत, ज़ोर से, जब तक वह असर न करे।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتتاحيتك، بصوت عالٍ، حتى تصيب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冒頭の一言を、決まるまで声に出して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫마디를, 제대로 전달될 때까지 소리 내어."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大声练习你的开场白，直到说到位。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembukaanmu, dengan suara keras, sampai mengena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pambungad mo, nang malakas, hanggang tumama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu mở đầu, thành tiếng, cho đến khi thật trôi chảy."
          }
        }
      }
    },
    "Your opening, your experience, and the follow-ups.": {
