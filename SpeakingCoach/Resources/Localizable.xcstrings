    "Practice the exact question until the answer is there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica la pregunta exacta hasta que la respuesta esté ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi sur la question exacte jusqu'à ce que la réponse vienne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe genau die Frage, bis die Antwort sitzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati sulla domanda esatta finché la risposta non c'è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique a pergunta exata até a resposta estar lá."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen precies die vraag tot het antwoord er is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz dokładnie to pytanie, aż odpowiedź będzie gotowa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva på exakt den frågan tills svaret sitter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt oturana kadar tam o soruyu çalış."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрабатывайте именно этот вопрос, пока ответ не сложится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпрацьовуйте саме це питання, доки відповідь не складеться."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक उसी सवाल का तब तक अभ्यास करें जब तक जवाब तैयार न हो।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على السؤال نفسه حتى تحضر الإجابة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えが出てくるまで、その質問そのものを練習しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답이 떠오를 때까지 그 질문 그대로 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反复练习那个问题，直到答案自然出现。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih pertanyaan yang persis sama sampai jawabannya muncul."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-practice ang mismong tanong hanggang lumabas ang sagot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện đúng câu hỏi đó cho đến khi câu trả lời hiện ra."
          }
        }
      }
    },
