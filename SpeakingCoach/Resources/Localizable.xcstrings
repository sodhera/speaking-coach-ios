    "Too many tries. Wait a minute and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera un minuto y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Attends une minute et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warte eine Minute und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Aspetta un minuto e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas. Espere um minuto e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Wacht een minuut en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób. Odczekaj minutę i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många försök. Vänta en minut och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla deneme. Bir dakika bekle ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Подождите минуту и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб. Зачекайте хвилину й спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा कोशिशें। एक मिनट रुकें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. انتظر دقيقة وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。1分待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많아요. 1분 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请等一分钟再试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan. Tunggu satu menit dan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming subok. Maghintay ng isang minuto at subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử quá nhiều lần. Đợi một phút rồi thử lại."
          }
        }
      }
    },
