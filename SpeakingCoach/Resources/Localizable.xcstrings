    "Could you say a little more about what you need from me?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Podrías contarme un poco más sobre lo que necesitas de mí?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourrais-tu m'en dire un peu plus sur ce dont tu as besoin ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannst du mir etwas mehr darüber erzählen, was du von mir brauchst?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti dirmi qualcosa in più su cosa ti serve da me?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você poderia me contar um pouco mais sobre o que precisa de mim?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun je iets meer vertellen over wat je van me nodig hebt?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz powiedzieć trochę więcej o tym, czego ode mnie potrzebujesz?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan du berätta lite mer om vad du behöver från mig?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benden neye ihtiyacın olduğunu biraz daha anlatabilir misin?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете рассказать чуть подробнее, что вам от меня нужно?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете трохи детальніше розповісти, що вам від мене потрібно?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप थोड़ा और बता सकते हैं कि आपको मुझसे क्या चाहिए?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنك أن تخبرني أكثر قليلًا عمّا تحتاجه مني؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私に何をしてほしいか、もう少し詳しく教えてもらえますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제가 무엇을 해 드리면 좋을지 조금 더 말씀해 주시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你能再具体说说需要我做什么吗？"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa jelaskan sedikit lagi apa yang kamu butuhkan dari saya?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mo bang sabihin nang kaunti pa kung ano ang kailangan mo sa akin?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể nói rõ hơn một chút bạn cần gì ở tôi không?"
          }
        }
      }
    },
