    "Your plan wasn't saved. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan no se guardó. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton plan n'a pas été enregistré. Vérifie ta connexion et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan wurde nicht gespeichert. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano non è stato salvato. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano não foi salvo. Verifique sua conexão e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plan is niet bewaard. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan nie został zapisany. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan sparades inte. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planın kaydedilmedi. Bağlantını kontrol et ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План не сохранён. Проверьте подключение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "План не збережено. Перевірте з'єднання й спробуйте знову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्लान सहेजा नहीं गया। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحفظ خطتك. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを保存できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜을 저장하지 못했어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的计划未能保存。请检查网络连接后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketmu tidak tersimpan. Periksa koneksimu dan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na-save ang plan mo. Tingnan ang koneksyon mo at subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu được kế hoạch. Kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
