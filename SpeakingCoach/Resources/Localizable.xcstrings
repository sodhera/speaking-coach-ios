    "Apple didn't return a sign-in token. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no devolvió un token de inicio de sesión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas renvoyé de jeton de connexion. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat kein Anmeldetoken zurückgegeben. Bitte versuch es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha restituito un token di accesso. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não retornou um token de login. Tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gaf geen inlogtoken terug. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nie zwrócił tokenu logowania. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple returnerade ingen inloggningstoken. Försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bir giriş belirteci döndürmedi. Lütfen tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не вернул токен входа. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не повернув токен входу. Спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ने साइन-इन टोकन नहीं लौटाया। कृपया दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع Apple رمز تسجيل الدخول. يُرجى المحاولة مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleからサインイン用トークンが返されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 로그인 토큰을 받지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未返回登录令牌。请重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak mengembalikan token masuk. Silakan coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nagbalik ang Apple ng sign-in token. Pakisubukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không trả về mã đăng nhập. Vui lòng thử lại."
          }
        }
      }
    },
