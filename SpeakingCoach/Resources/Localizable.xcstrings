    "Good. You painted the scene.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien. Has pintado la escena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien. Tu as bien décrit la scène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut. Du hast die Szene beschrieben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bene. Hai descritto la scena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem. Você descreveu a cena."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed. Je hebt de scène neergezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrze. Udało ci się opisać scenę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra. Du målade upp scenen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güzel. Sahneyi anlattın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо. Вы описали сцену."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Добре. Ви описали сцену."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया। आपने दृश्य को बयान किया।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جيد. رسمت المشهد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいですね。情景が伝わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요. 장면이 잘 그려졌어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很好。你把画面描绘出来了。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagus. Kamu menggambarkan suasananya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maganda. Naipinta mo ang eksena."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốt. Bạn đã vẽ nên khung cảnh."
          }
        }
      }
    },
    "Hear it back": {
      "localizations": {
