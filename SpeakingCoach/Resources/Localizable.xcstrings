    "That answer was too short to hear. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa respuesta fue demasiado corta para oírla. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette réponse était trop courte pour être entendue. Réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort war zu kurz, um sie zu hören. Versuch es noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta era troppo breve per essere sentita. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa resposta foi curta demais para ouvir. Tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat antwoord was te kort om te horen. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta odpowiedź była zbyt krótka, by ją usłyszeć. Spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret var för kort för att höras. Försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt duyulamayacak kadar kısaydı. Tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ был слишком коротким. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь була надто короткою. Спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह जवाब सुनने के लिए बहुत छोटा था। दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت الإجابة أقصر من أن تُسمع. حاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が短すぎて聞き取れませんでした。もう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 너무 짧아서 들리지 않았어요. 다시 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答太短，没听清。请再试一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban itu terlalu pendek untuk didengar. Coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maikli ang sagot na iyon para marinig. Subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời quá ngắn để nghe được. Thử lại nhé."
          }
        }
      }
    },
    "That conversation is almost here.": {
      "localizations": {
