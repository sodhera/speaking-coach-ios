    "We didn't catch enough. Try once more, a little closer to the phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No captamos lo suficiente. Inténtalo otra vez, un poco más cerca del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On n'a pas assez entendu. Réessaie, un peu plus près du téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben nicht genug verstanden. Versuch es noch einmal, etwas näher am Telefon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo sentito abbastanza. Riprova, un po' più vicino al telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não captamos o suficiente. Tente mais uma vez, um pouco mais perto do celular."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hoorden niet genoeg. Probeer het nog eens, iets dichter bij de telefoon."
          }
        },
        "pl": {
          "stringUnit": {
