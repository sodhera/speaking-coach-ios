        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت مستعد لدخول اجتماعك القادم وأنت متهيئ؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の会議に準備万端で臨む準備はできましたか？"
