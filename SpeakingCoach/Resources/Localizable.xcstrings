    "Your apps are shielded now. Speak to open them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps están bloqueadas ahora. Habla para abrirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps sont bloquées. Parle pour les ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps sind jetzt gesperrt. Sprich, um sie zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app ora sono bloccate. Parla per aprirle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps estão bloqueados agora. Fale para abri-los."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps zijn nu afgeschermd. Spreek om ze te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje są teraz zablokowane. Powiedz coś, aby je otworzyć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar är spärrade nu. Prata för att öppna dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaların şu anda engelli. Açmak için konuş."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения сейчас заблокированы. Скажите что-нибудь, чтобы открыть их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми зараз заблоковано. Скажіть щось, щоб відкрити їх."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ऐप अभी रुके हुए हैं। उन्हें खोलने के लिए बोलें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيقاتك محجوبة الآن. تحدّث لفتحها."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは現在制限されています。話して開きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 앱이 잠겨 있어요. 말해서 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 App 现已锁定。开口说话即可打开。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App-mu sekarang terkunci. Bicaralah untuk membukanya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakaharang na ang apps mo. Magsalita para mabuksan ang mga ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng của bạn đang bị chặn. Hãy nói để mở."
          }
        }
      }
    },
