    "Mention two things happening in the scene, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menciona dos cosas que pasan en la escena y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentionne deux choses qui se passent dans la scène, puis réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne zwei Dinge, die in der Szene passieren, und versuch es noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cita due cose che succedono nella scena, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencione duas coisas que acontecem na cena e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem twee dingen die in de scène gebeuren en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymień dwie rzeczy, które dzieją się w scenie, i spróbuj ponownie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämn två saker som händer i scenen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahnede olan iki şeyden bahset ve tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите две вещи, которые происходят в сцене, и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвіть дві речі, які відбуваються в сцені, і спробуйте ще раз."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दृश्य में हो रही दो चीज़ें बताएँ, फिर दोबारा कोशिश करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اذكر أمرين يحدثان في المشهد، ثم حاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーンで起きていることを二つ挙げて、もう一度どうぞ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면에서 일어나는 일 두 가지를 말하고 다시 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出场景中正在发生的两件事，再试一次。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan dua hal yang terjadi dalam adegan, lalu coba lagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Banggitin ang dalawang nangyayari sa eksena, tapos subukan ulit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nêu hai điều đang diễn ra trong khung cảnh, rồi thử lại."
          }
        }
      }
    },
