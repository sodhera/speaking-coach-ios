    "Interviews, updates, asks, and the hard talks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrevistas, novedades, peticiones y las charlas difíciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entretiens, points d'avancement, demandes et discussions difficiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorstellungsgespräche, Updates, Anliegen und schwierige Gespräche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colloqui, aggiornamenti, richieste e le conversazioni difficili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrevistas, atualizações, pedidos e as conversas difíceis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollicitaties, updates, verzoeken en de lastige gesprekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowy kwalifikacyjne, raporty, prośby i trudne rozmowy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervjuer, uppdateringar, önskemål och de svåra samtalen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mülakatlar, güncellemeler, talepler ve zor konuşmalar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собеседования, отчёты, просьбы и трудные разговоры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Співбесіди, звіти, прохання та складні розмови."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरव्यू, अपडेट, माँगें और मुश्किल बातचीत।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقابلات، والتحديثات، والطلبات، والمحادثات الصعبة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面接、報告、お願い、そして難しい話し合い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면접, 업무 보고, 요청, 그리고 어려운 대화."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面试、汇报、提要求，以及艰难的谈话。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wawancara, laporan, permintaan, dan pembicaraan sulit."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Interview, update, paghingi, at mahihirap na usapan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phỏng vấn, báo cáo, đề nghị và những cuộc nói chuyện khó."
          }
        }
      }
    },
    "Introductions, small talk, and saying what you mean.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentaciones, charla informal y decir lo que piensas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présentations, petites conversations et dire ce que tu penses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorstellen, Smalltalk und sagen, was du meinst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentarsi, chiacchiere e dire ciò che intendi."
          }
        },
        "pt-BR": {
          "stringUnit": {
