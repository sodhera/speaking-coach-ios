          "stringUnit": {
            "state": "translated",
            "value": "उस प्रेज़ेंटेशन में 100 से ज़्यादा स्लाइड हैं। छोटा संस्करण आज़माएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا العرض على أكثر من 100 شريحة. جرّب نسخة أقصر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドが100枚を超えています。短いバージョンをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드가 100장을 넘어요. 더 짧은 버전으로 시도해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该演讲超过100张幻灯片。请尝试精简版本。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentasi itu lebih dari 100 slide. Coba versi yang lebih pendek."
