    "Your plan is saved, but notifications are off. Turn them on in Settings for the reminder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan está guardado, pero las notificaciones están desactivadas. Actívalas en Ajustes para el recordatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton plan est enregistré, mais les notifications sont désactivées. Active-les dans Réglages pour le rappel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan ist gespeichert, aber Mitteilungen sind aus. Schalte sie für die Erinnerung in den Einstellungen ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano è salvato, ma le notifiche sono disattivate. Attivale in Impostazioni per il promemoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano está salvo, mas as notificações estão desativadas. Ative-as em Ajustes para o lembrete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plan is bewaard, maar meldingen staan uit. Zet ze aan in Instellingen voor de herinnering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan jest zapisany, ale powiadomienia są wyłączone. Włącz je w Ustawieniach, aby dostać przypomnienie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan är sparad, men notiser är avstängda. Slå på dem i Inställningar för påminnelsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planın kaydedildi ama bildirimler kapalı. Hatırlatıcı için Ayarlar'dan aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План сохранён, но уведомления выключены. Включите их в Настройках для напоминания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "План збережено, але сповіщення вимкнено. Увімкніть їх у Параметрах для нагадування."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्लान सहेजा गया, लेकिन सूचनाएँ बंद हैं। रिमाइंडर के लिए सेटिंग्स में इन्हें चालू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطتك محفوظة، لكن الإشعارات متوقفة. شغّلها في الإعدادات لتصلك التذكير."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランは保存されましたが、通知がオフです。リマインダーを受け取るには「設定」でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜은 저장됐지만 알림이 꺼져 있어요. 알림을 받으려면 설정에서 켜 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的计划已保存，但通知已关闭。请在“设置”中打开以接收提醒。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketmu tersimpan, tapi notifikasi mati. Nyalakan di Pengaturan untuk mendapat pengingat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save ang plan mo, pero naka-off ang notifications. I-on ang mga ito sa Settings para sa mga paalala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch đã được lưu, nhưng thông báo đang tắt. Bật trong Cài đặt để nhận lời nhắc."
          }
        }
      }
    },
    "Your plan is saved. The event is too close for a 9 am reminder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan está guardado. El evento está demasiado cerca para un recordatorio a las 9:00."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton plan est enregistré. L'événement est trop proche pour un rappel à 9 h."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan ist gespeichert. Der Termin ist zu nah für eine Erinnerung um 9 Uhr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano è salvato. L'evento è troppo vicino per un promemoria alle 9."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano está salvo. O evento está perto demais para um lembrete às 9h."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plan is bewaard. Het evenement is te dichtbij voor een herinnering om 9:00 uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan jest zapisany. Wydarzenie jest zbyt blisko na przypomnienie o 9:00."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan är sparad. Evenemanget är för nära för en påminnelse kl. 9."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planın kaydedildi. Etkinlik saat 09.00 hatırlatması için fazla yakın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План сохранён. Событие слишком близко для напоминания в 9:00."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "План збережено. Подія надто близько для нагадування о 9:00."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्लान सहेजा गया। इवेंट सुबह 9 बजे के रिमाइंडर के लिए बहुत पास है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطتك محفوظة. الحدث أقرب من أن يُضبط له تذكير الساعة 9 صباحًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランは保存されました。予定が近すぎるため、午前9時のリマインダーは設定できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜이 저장됐어요. 일정이 너무 가까워서 오전 9시 알림은 설정할 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的计划已保存。活动时间太近，无法设置上午9点的提醒。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketmu tersimpan. Acaranya terlalu dekat untuk pengingat pukul 9 pagi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save ang plan mo. Masyadong malapit ang event para sa paalala nang alas-9 ng umaga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch đã được lưu. Sự kiện quá gần để đặt lời nhắc lúc 9 giờ sáng."
          }
        }
      }
    },
