        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ta connexion au compte. Vérifie ta connexion Internet et réessaie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anmeldung konnte nicht bestätigt werden. Prüfe deine Verbindung und versuch es erneut."
          }
        },
        "it": {
