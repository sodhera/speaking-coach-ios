          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara untuk membuka"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magsalita para ma-unlock"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói để mở khóa"
          }
        }
      }
    },
    "Speak to unlock needs Screen Time on a real iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla para desbloquear necesita Tiempo de uso en un iPhone real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle pour débloquer nécessite Temps d'écran sur un vrai iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen zum Entsperren braucht die Bildschirmzeit auf einem echten iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla per sbloccare richiede Tempo di utilizzo su un vero iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale para desbloquear precisa do Tempo de Uso em um iPhone de verdade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek om te ontgrendelen heeft Schermtijd nodig op een echte iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Mów, by odblokować wymaga Czasu przed ekranem na prawdziwym iPhonie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata för att låsa upp kräver Skärmtid på en riktig iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi açmak için konuş, gerçek bir iPhone'da Ekran Süresi gerektirir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции «Скажи, чтобы разблокировать» нужно Экранное время на настоящем iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функції «Скажіть, щоб розблокувати» потрібен Екранний час на справжньому iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक के लिए बोलें को असली iPhone पर स्क्रीन टाइम चाहिए।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج ميزة «تحدّث لفتح القفل» إلى مدة استخدام الجهاز على iPhone حقيقي."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話してロック解除」には実機のiPhoneのスクリーンタイムが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말해서 잠금 해제는 실제 iPhone의 스크린 타임이 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开口解锁需要在真实 iPhone 上使用屏幕使用时间。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara untuk membuka membutuhkan Durasi Layar di iPhone asli."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Magsalita para ma-unlock ang Screen Time sa totoong iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói để mở khóa cần Thời gian sử dụng trên iPhone thật."
          }
        }
      }
    },
    "Speak to unlock uses Screen Time, so it's set up on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla para desbloquear usa Tiempo de uso, así que se configura en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle pour débloquer utilise Temps d'écran, donc il se configure sur ton iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen zum Entsperren nutzt die Bildschirmzeit und wird deshalb auf deinem iPhone eingerichtet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla per sbloccare usa Tempo di utilizzo, quindi si configura sul tuo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale para desbloquear usa o Tempo de Uso, então é configurado no seu iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek om te ontgrendelen gebruikt Schermtijd, dus je stelt het in op je iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Mów, by odblokować korzysta z Czasu przed ekranem, więc konfiguruje się ją na iPhonie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata för att låsa upp använder Skärmtid, så det ställs in på din iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi açmak için konuş, Ekran Süresi'ni kullanır; bu yüzden iPhone'unda ayarlanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функция «Скажи, чтобы разблокировать» использует Экранное время, поэтому она настраивается на iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функція «Скажіть, щоб розблокувати» використовує Екранний час, тому налаштовується на iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक के लिए बोलें स्क्रीन टाइम का उपयोग करता है, इसलिए इसे आपके iPhone पर सेट किया जाता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم ميزة «تحدّث لفتح القفل» مدة استخدام الجهاز، لذا تُضبط على iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話してロック解除」はスクリーンタイムを使うため、iPhoneで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말해서 잠금 해제는 스크린 타임을 사용하므로 iPhone에서 설정해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开口解锁使用屏幕使用时间，所以要在你的 iPhone 上设置。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara untuk membuka menggunakan Durasi Layar, jadi diatur di iPhone-mu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ng Screen Time ang Magsalita para ma-unlock, kaya sa iPhone mo ito sine-set up."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói để mở khóa dùng Thời gian sử dụng, nên được thiết lập trên iPhone của bạn."
          }
        }
      }
    },
    "Speaking Coach %@ is ready. Update to get the latest improvements.": {
      "localizations": {
