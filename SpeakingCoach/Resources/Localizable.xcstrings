    "Meet people and keep the conversation going.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce gente y mantén viva la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencontre des gens et fais vivre la conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne Leute kennen und halte das Gespräch am Laufen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosci persone e fai andare avanti la conversazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça pessoas e mantenha a conversa fluindo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontmoet mensen en houd het gesprek gaande."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznawaj ludzi i podtrzymuj rozmowę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träffa människor och håll samtalet igång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlarla tanış ve sohbeti sürdür."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знакомьтесь и поддерживайте разговор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайомтеся й підтримуйте розмову."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगों से मिलें और बातचीत जारी रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على الناس وحافظ على استمرار الحديث."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人と出会い、会話を続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사람을 만나고 대화를 이어가세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结识新朋友，让对话继续下去。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertemu orang dan jaga percakapan tetap mengalir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakilala ng tao at ituloy ang usapan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gặp gỡ mọi người và duy trì cuộc trò chuyện."
          }
        }
      }
    },
